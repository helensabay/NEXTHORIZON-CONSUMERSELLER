<script>
let searchDebounceTimer = null;

function handleOverlaySearch(value) {
    clearTimeout(searchDebounceTimer);
    searchDebounceTimer = setTimeout(() => {
        const query = value.trim();
        if (query.length === 0) { closeSuggestionsDropdown(); return; }
        fetchSuggestions(query);
    }, 250);
}

async function fetchSuggestions(query) {
    try {
        const res = await fetch(`/Home/SearchSuggestions?query=${encodeURIComponent(query)}`);
        const data = await res.json();
        renderSuggestionsDropdown(data, query);
    } catch (e) { console.error('Suggestion fetch failed', e); }
}

function renderSuggestionsDropdown(suggestions, query) {
    closeSuggestionsDropdown();
    if (!suggestions || suggestions.length === 0) return;

    const input = document.getElementById('searchInput');
    const dropdown = document.createElement('div');
    dropdown.id = 'searchDropdown';
    dropdown.style.cssText = `
        position:fixed;
        top:${input.getBoundingClientRect().bottom + 4}px;
        left:${input.getBoundingClientRect().left}px;
        width:${input.offsetWidth + 40}px;
        background:white;
        border:1px solid #ddd;
        border-radius:8px;
        box-shadow:0 8px 24px rgba(0,0,0,0.15);
        z-index:99999;
        overflow:hidden;
    `;

    suggestions.forEach(item => {
        const div = document.createElement('div');
        div.style.cssText = `padding:10px 16px; cursor:pointer; display:flex;
            align-items:center; gap:10px; font-size:14px; color:#111;`;

        const text = item.suggestion;
        const idx = text.toLowerCase().indexOf(query.toLowerCase());
        let highlighted = text;
        if (idx >= 0) {
            highlighted = text.slice(0, idx) +
                `<strong>${text.slice(idx, idx + query.length)}</strong>` +
                text.slice(idx + query.length);
        }

        div.innerHTML = `<i class="fas fa-search" style="color:#aaa;font-size:12px;flex-shrink:0;"></i><span>${highlighted}</span>`;
        div.onmouseenter = () => div.style.background = '#f5f5f5';
        div.onmouseleave = () => div.style.background = 'white';
        div.onclick = () => {
            closeSuggestionsDropdown();
            window.location.href = `/Home/SearchPage?query=${encodeURIComponent(item.suggestion)}`;
        };
        dropdown.appendChild(div);
    });

    document.body.appendChild(dropdown);
}

function closeSuggestionsDropdown() {
    const existing = document.getElementById('searchDropdown');
    if (existing) existing.remove();
}

document.addEventListener('click', (e) => {
    if (!e.target.closest('#searchForm')) closeSuggestionsDropdown();
});

async function submitSearch(event) {
    if (event) event.preventDefault();
    const query = document.getElementById('searchInput').value.trim();
    if (!query) return;
    closeSuggestionsDropdown();
    window.location.href = `/Home/SearchPage?query=${encodeURIComponent(query)}`;
}

function toggleSearch() {
    const expand = document.getElementById('searchExpand');
    const input  = document.getElementById('searchInput');
    const isOpen = expand.classList.contains('open');
    expand.classList.toggle('open');
    if (!isOpen) {
        setTimeout(() => input.focus(), 350);
    } else {
        input.value = '';
        closeSuggestionsDropdown();
    }
}

document.addEventListener('click', (e) => {
    const wrapper = document.getElementById('searchWrapper');
    if (wrapper && !wrapper.contains(e.target)) {
        document.getElementById('searchExpand').classList.remove('open');
    }
    if (!e.target.closest('#searchForm')) closeSuggestionsDropdown();
});

function openQuickView(image, name, brand, price, category, sku, sizes, stock) {
    const imgPath = image && image.trim() !== ''
        ? '/uploads/products/' + image
        : '';
    document.getElementById('qv-img').src = imgPath;
    document.getElementById('qv-name').textContent = name;
    document.getElementById('qv-brand').textContent = brand;
    document.getElementById('qv-price').textContent = '₱' + parseFloat(price).toFixed(2);
    document.getElementById('qv-category').textContent = category || 'N/A';
    document.getElementById('qv-sku').textContent = sku || 'N/A';
    document.getElementById('qv-stock').textContent = stock > 0 ? stock + ' left in stock' : 'Out of Stock';
    document.getElementById('qv-selected-size').textContent = '';

    const sizesContainer = document.getElementById('qv-sizes');
    sizesContainer.innerHTML = '';
    if (sizes) {
        sizes.split(',').forEach(size => {
            if (size.trim()) {
                const btn = document.createElement('button');
                btn.className = 'qv-size-btn';
                btn.textContent = size.trim();
                btn.onclick = function() {
                    document.querySelectorAll('.qv-size-btn').forEach(b => b.classList.remove('selected'));
                    this.classList.add('selected');
                    document.getElementById('qv-selected-size').textContent = this.textContent;
                };
                sizesContainer.appendChild(btn);
            }
        });
    } else {
        sizesContainer.innerHTML = '<span style="color:#999;font-size:0.8rem;">No sizes available</span>';
    }

    document.getElementById('quickViewModal').style.display = 'block';
    document.body.style.overflow = 'hidden';
}

function closeModal() {
    document.getElementById('quickViewModal').style.display = 'none';
    document.body.style.overflow = '';
}

function closeQuickView(event) {
    if (event.target === document.getElementById('quickViewModal')) {
        closeModal();
    }
}

function escapeHtml(str) {
    if (!str) return '';
    return str.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
}
</script>
    @await RenderSectionAsync("Scripts", required: false)

</body>
