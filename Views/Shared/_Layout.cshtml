    <script>
        window.setConsumerMessengerHeaderLink = function (href) {
            const link = document.getElementById('header-consumer-messenger-link');
            if (!link) return;

            if (!href) {
                link.style.display = 'none';
                link.removeAttribute('href');
                return;
            }

            link.href = href;
            link.style.display = 'inline-flex';
        };
    </script>
    @await RenderSectionAsync("Scripts", required: false)

