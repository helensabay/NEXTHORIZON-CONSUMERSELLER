@{
    var showConsumerMessengerLink = ViewData["ShowConsumerMessengerLink"] as bool? ?? false;
    var consumerMessengerHref = ViewData["ConsumerMessengerHref"]?.ToString() ?? "/consumer/messenger/";
    var bodyClass = ViewData["BodyClass"]?.ToString();
    var hasConsumerMessengerLayout = !string.IsNullOrWhiteSpace(bodyClass) && bodyClass.Contains("consumer-messenger-layout");
    var isEmbeddedMessenger = !string.IsNullOrWhiteSpace(bodyClass) && bodyClass.Contains("consumer-messenger-embed");
    var isLoggedIn = Context.Session.GetInt32("UserId") != null
        || !string.IsNullOrWhiteSpace(Context.Request.Cookies["NextHorizon.SharedUserId"]);
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="NEXT HORIZON - Premium Running Gear. Engineered for Performance. Built for Runners.">
    <meta name="theme-color" content="#000000">
    <title>@ViewData["Title"] - NEXT HORIZON</title>
    
    <!-- Preconnect for Performance -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="dns-prefetch" href="//localhost">
    
    <!-- Premium Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@100;200;300;400;500;600;700;800;900&family=Space+Grotesk:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <!-- Styles -->
    <link rel="stylesheet" href="~/css/style.css" asp-append-version="true">
    <link rel="stylesheet" href="~/css/header.css" asp-append-version="true">
    <link rel="stylesheet" href="~/css/product-details.css" asp-append-version="true">
    <link rel="stylesheet" href="~/css/products.css" asp-append-version="true">
    <link rel="stylesheet" href="~/css/loading.css" asp-append-version="true">
    @if (hasConsumerMessengerLayout)
    {
        <link rel="stylesheet" href="~/css/consumer-messenger.css" asp-append-version="true">
    }
    @if (isEmbeddedMessenger)
    {
        <style>
            html, body.consumer-messenger-embed {
                height: 100%;
                overflow: hidden;
                background: #f6f7fa;
            }

            body.consumer-messenger-embed .loading-overlay,
            body.consumer-messenger-embed #main-header,
            body.consumer-messenger-embed #search-dropdown,
            body.consumer-messenger-embed .site-footer-dark,
            body.consumer-messenger-embed #reviews-modal,
            body.consumer-messenger-embed #login-modal,
            body.consumer-messenger-embed #toast-container {
                display: none !important;
            }

            body.consumer-messenger-embed .main-content {
                min-height: 100vh;
                height: 100vh;
                padding: 0;
                margin: 0;
            }
        </style>
    }
    @await RenderSectionAsync("Styles", required: false)
    <script>
        (() => {
            const warmedOrigins = new Set();
            const warmNavigation = href => {
                if (!href) {
                    return;
                }

                try {
                    const url = new URL(href, window.location.origin);
                    if (url.origin === window.location.origin || warmedOrigins.has(url.origin)) {
                        return;
                    }

                    warmedOrigins.add(url.origin);

                    const preconnect = document.createElement('link');
                    preconnect.rel = 'preconnect';
                    preconnect.href = url.origin;
                    document.head.appendChild(preconnect);

                    const prefetch = document.createElement('link');
                    prefetch.rel = 'prefetch';
                    prefetch.as = 'document';
                    prefetch.href = url.href;
                    document.head.appendChild(prefetch);
                } catch {
                }
            };

            const handleWarmEvent = event => {
                const anchor = event.target.closest?.('a[href]');
                if (anchor) {
                    warmNavigation(anchor.href);
                }
            };

            document.addEventListener('pointerenter', handleWarmEvent, true);
            document.addEventListener('focusin', handleWarmEvent, true);
            document.addEventListener('touchstart', handleWarmEvent, true);
        })();
    </script>
</head>
<body class="@bodyClass">
