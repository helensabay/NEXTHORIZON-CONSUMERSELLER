@model NextHorizon.Models.TransactionHistoryViewModel

@{
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
}

@section Styles{
    <link rel="stylesheet" href="~/css/finance.css" />
    <link rel="stylesheet" href="~/css/transactionhistory.css" />
}

@{
    ViewData["Title"] = "Transaction History";
    ViewData["DashboardHeading"] = "Transaction History";
    ViewData["SellerName"] = Model.SellerName;
}

<!-- Page Actions (Back Button) -->
<div class="page-actions">
    <a class="link-btn" asp-controller="Dashboard" asp-action="Finance">
        <i class="fas fa-arrow-left"></i> Back to Finance
    </a>
</div>

<!-- Filter Section -->
<section class="section">
    <h3 class="section-title">Filter Transactions</h3>
    <div class="filter-container">
        <form method="get" asp-action="TransactionHistory" class="filter-form">
            <div class="filter-grid">
                <div class="filter-group">
                    <label for="type">Transaction Type</label>
                    <select name="type" id="type" class="filter-select">
                        <option value="">All Types</option>
                        <option value="Withdrawal" selected="@(Model.FilterType == "Withdrawal")">Withdrawal</option>
                        <option value="Order Payout" selected="@(Model.FilterType == "Order Payout")">Order Payout</option>
                        <option value="Refund" selected="@(Model.FilterType == "Refund")">Refund</option>
                    </select>
                </div>

                <div class="filter-group">
                    <label for="status">Status</label>
                    <select name="status" id="status" class="filter-select">
                        <option value="">All Status</option>
                        <option value="Completed" selected="@(Model.FilterStatus == "Completed")">Completed</option>
                        <option value="Pending" selected="@(Model.FilterStatus == "Pending")">Pending</option>
                        <option value="Failed" selected="@(Model.FilterStatus == "Failed")">Failed</option>
                    </select>
                </div>

                <div class="filter-group">
                    <label for="fromDate">From Date</label>
                    <input type="date" name="fromDate" id="fromDate" class="filter-input" 
                           value="@(Model.FilterFromDate?.ToString("yyyy-MM-dd"))" />
                </div>

                <div class="filter-group">
                    <label for="toDate">To Date</label>
                    <input type="date" name="toDate" id="toDate" class="filter-input" 
                           value="@(Model.FilterToDate?.ToString("yyyy-MM-dd"))" />
                </div>

                <div class="filter-group filter-actions">
                    <button type="submit" class="btn-filter">
                        <i class="fas fa-filter"></i> Apply Filters
                    </button>
                    <a href="@Url.Action("TransactionHistory")" class="btn-reset">
                        <i class="fas fa-undo"></i> Reset
                    </a>
                </div>
            </div>
        </form>
    </div>
</section>

<!-- Transactions Table -->
<section class="section">
    <div class="table-header">
        <h3 class="section-title">All Transactions</h3>
        <div class="table-info">
            Showing @Model.Transactions.Count of @Model.TotalCount transactions
        </div>
    </div>

    <div class="table-container">
        <table class="orders-table">
            <thead>
                <tr>
                    <th>Reference</th>
                    <th>Date</th>
                    <th>Type</th>
                    <th>Method</th>
                    <th>Amount</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var tx in Model.Transactions)
                {
                    <tr>
                        <td>@tx.ReferenceId</td>
                        <td>@tx.TransactionDate.ToString("MMM dd, yyyy hh:mm tt")</td>
                        <td>
                            <span class="transaction-type">
                                @if (tx.Type.Contains("Withdrawal"))
                                {
                                    <i class="fas fa-arrow-up text-warning"></i>
                                }
                                else if (tx.Type.Contains("Payout"))
                                {
                                    <i class="fas fa-arrow-down text-success"></i>
                                }
                                else if (tx.Type.Contains("Refund"))
                                {
                                    <i class="fas fa-undo text-danger"></i>
                                }
                                else
                                {
                                    <i class="fas fa-exchange-alt"></i>
                                }
                                @tx.Type
                            </span>
                        </td>
                        <td>@tx.Method</td>
                        <td class="@(tx.Amount < 0 ? "amount-negative" : "amount-positive")">
                            @if (tx.Amount < 0)
                            {
                                <span>- &#8369;@Math.Abs(tx.Amount).ToString("N2")</span>
                            }
                            else
                            {
                                <span>+ &#8369;@tx.Amount.ToString("N2")</span>
                            }
                        </td>
                        <td>
                            <span class="badge status 
                                @(tx.Status.Equals("Pending", StringComparison.OrdinalIgnoreCase) ? "pending" : 
                                  tx.Status.Equals("Completed", StringComparison.OrdinalIgnoreCase) ? "complete" : 
                                  tx.Status.Equals("Failed", StringComparison.OrdinalIgnoreCase) ? "failed" : "")">
                                @tx.Status
                            </span>
                        </td>
                        <td class="action-buttons">
                            <button onclick="openTransactionModal('@tx.ReferenceId')" class="btn-view" title="View Details">
                                <i class="fas fa-eye"></i>
                            </button>
                            @if (tx.Status.Equals("Pending", StringComparison.OrdinalIgnoreCase) && tx.Type.Contains("Withdrawal"))
                            {
                                <a asp-action="CancelWithdrawal" asp-route-id="@tx.ReferenceId" 
                                   class="btn-cancel" title="Cancel Withdrawal"
                                   onclick="return confirm('Are you sure you want to cancel this withdrawal request?')">
                                    <i class="fas fa-times"></i>
                                </a>
                            }
                        </td>
                    </tr>
                }
                @if (!Model.Transactions.Any())
                {
                    <tr>
                        <td colspan="7" class="empty-state">
                            <i class="fas fa-receipt fa-3x mb-3"></i>
                            <h5>No transactions found</h5>
                            <p class="text-muted">Try adjusting your filters or check back later</p>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Pagination -->
    @if (Model.TotalPages > 1)
    {
        <div class="pagination-container">
            <ul class="pagination">
                @if (Model.CurrentPage > 1)
                {
                    <li class="page-item">
                        <a class="page-link" href="@Url.Action("TransactionHistory", new { 
                            page = Model.CurrentPage - 1,
                            type = Model.FilterType,
                            status = Model.FilterStatus,
                            fromDate = Model.FilterFromDate?.ToString("yyyy-MM-dd"),
                            toDate = Model.FilterToDate?.ToString("yyyy-MM-dd")
                        })">
                            <i class="fas fa-chevron-left"></i> Previous
                        </a>
                    </li>
                }

                @for (int i = 1; i <= Model.TotalPages; i++)
                {
                    <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                        <a class="page-link" href="@Url.Action("TransactionHistory", new { 
                            page = i,
                            type = Model.FilterType,
                            status = Model.FilterStatus,
                            fromDate = Model.FilterFromDate?.ToString("yyyy-MM-dd"),
                            toDate = Model.FilterToDate?.ToString("yyyy-MM-dd")
                        })">@i</a>
                    </li>
                }

                @if (Model.CurrentPage < Model.TotalPages)
                {
                    <li class="page-item">
                        <a class="page-link" href="@Url.Action("TransactionHistory", new { 
                            page = Model.CurrentPage + 1,
                            type = Model.FilterType,
                            status = Model.FilterStatus,
                            fromDate = Model.FilterFromDate?.ToString("yyyy-MM-dd"),
                            toDate = Model.FilterToDate?.ToString("yyyy-MM-dd")
                        })">
                            Next <i class="fas fa-chevron-right"></i>
                        </a>
                    </li>
                }
            </ul>
        </div>
    }
</section>

<!-- Transaction Details Modal -->
<div id="transactionModal" class="modal">
    <div class="modal-content">
        <div class="modal-header">
            <h3>Transaction Details</h3>
            <button class="modal-close" onclick="closeTransactionModal()">&times;</button>
        </div>
        <div class="modal-body" id="modalBody">
            <div class="modal-loader">
                <i class="fas fa-spinner"></i>
                <p>Loading transaction details...</p>
            </div>
        </div>
        <div class="modal-footer">
            <button class="btn-reset" onclick="closeTransactionModal()">Close</button>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function openTransactionModal(referenceId) {
            document.getElementById('transactionModal').style.display = 'block';
            document.body.style.overflow = 'hidden';
            
            // Load transaction details via AJAX using stored procedure
            fetch(`/Dashboard/GetTransactionDetailsSP?referenceId=${encodeURIComponent(referenceId)}`)
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        displayTransactionDetails(data.transaction);
                    } else {
                        document.getElementById('modalBody').innerHTML = `
                            <div class="empty-state">
                                <i class="fas fa-exclamation-circle fa-3x mb-3 text-danger"></i>
                                <h5>Error Loading Details</h5>
                                <p class="text-muted">${data.message || 'Unable to load transaction details'}</p>
                            </div>
                        `;
                    }
                })
                .catch(error => {
                    document.getElementById('modalBody').innerHTML = `
                        <div class="empty-state">
                            <i class="fas fa-exclamation-circle fa-3x mb-3 text-danger"></i>
                            <h5>Error</h5>
                            <p class="text-muted">An error occurred while loading transaction details</p>
                        </div>
                    `;
                });
        }
        function displayTransactionDetails(tx) {
            const typeIcon = getTypeIcon(tx.type);
            const statusClass = getStatusClass(tx.status);
            const amountClass = tx.amount < 0 ? 'amount-negative' : 'amount-positive';
            const amountSign = tx.amount < 0 ? '-' : '+';
            const absoluteAmount = Math.abs(tx.amount).toFixed(2);

            // Check if this is a pending withdrawal (from withdrawal_requests table)
            const isPendingWithdrawal = tx.source === 'withdrawal_request' && tx.status === 'Pending';
            
            const pendingWithdrawalInfo = isPendingWithdrawal ? `
                <div class="info-message">
                    <i class="fas fa-info-circle"></i>
                    <strong>Pending Withdrawal:</strong> This withdrawal request is still pending approval. Funds are still in your available balance.
                </div>
            ` : '';

            // Build additional details HTML if they exist
            let additionalDetailsHtml = '';
            if (tx.additionalDetails && Object.keys(tx.additionalDetails).length > 0) {
                let detailsRows = '';
                for (const [key, value] of Object.entries(tx.additionalDetails)) {
                    detailsRows += `
                        <div class="detail-row">
                            <span class="detail-label">${key}</span>
                            <span class="detail-value">${value || 'N/A'}</span>
                        </div>
                    `;
                }
                
                additionalDetailsHtml = `
                    <div class="detail-card">
                        <h4 style="margin-top: 0; margin-bottom: 15px; font-size: 1rem; color: #64748b;">Additional Details</h4>
                        ${detailsRows}
                    </div>
                `;
            }

            const detailsHtml = `
                <div class="transaction-detail-grid">
                    ${pendingWithdrawalInfo}
                    
                    <div class="detail-card" style="display: flex; align-items: center; gap: 15px;">
                        <div class="type-icon-lg ${typeIcon.class}">
                            <i class="${typeIcon.icon}"></i>
                        </div>
                        <div>
                            <h4 style="margin: 0 0 5px 0; font-size: 1.1rem;">${tx.type}</h4>
                            <span class="status-badge ${statusClass}">${tx.status}</span>
                        </div>
                    </div>

                    <div class="detail-card">
                        <div class="detail-row">
                            <span class="detail-label">Reference Number</span>
                            <span class="detail-value">${tx.referenceId}</span>
                        </div>
                        <div class="detail-row">
                            <span class="detail-label">Transaction Date</span>
                            <span class="detail-value">${new Date(tx.transactionDate).toLocaleString()}</span>
                        </div>
                        <div class="detail-row">
                            <span class="detail-label">Transaction Type</span>
                            <span class="detail-value">${tx.type}</span>
                        </div>
                        <div class="detail-row">
                            <span class="detail-label">Payment Method</span>
                            <span class="detail-value">${tx.method || 'N/A'}</span>
                        </div>
                        <div class="detail-row">
                            <span class="detail-label">Amount</span>
                            <span class="detail-value ${amountClass}">${amountSign} ₱${absoluteAmount}</span>
                        </div>
                        <div class="detail-row">
                            <span class="detail-label">Status</span>
                            <span class="detail-value">
                                <span class="status-badge ${statusClass}">${tx.status}</span>
                            </span>
                        </div>
                    </div>

                    ${additionalDetailsHtml}
                    
                    <div class="detail-card" style="background: #f0f9ff;">
                        <div class="detail-row">
                            <span class="detail-label">Source</span>
                            <span class="detail-value">${tx.source === 'wallet_transaction' ? 'Completed Transaction' : 'Pending Withdrawal Request'}</span>
                        </div>
                    </div>
                </div>
            `;

            document.getElementById('modalBody').innerHTML = detailsHtml;
        }
        
        function formatLabel(key) {
            // Convert camelCase or PascalCase to readable format
            return key.replace(/([A-Z])/g, ' $1')
                     .replace(/^./, str => str.toUpperCase())
                     .replace(/_/g, ' ');
        }

        function getTypeIcon(type) {
            if (type.includes('Withdrawal')) {
                return { icon: 'fas fa-arrow-up', class: 'withdrawal' };
            } else if (type.includes('Payout')) {
                return { icon: 'fas fa-arrow-down', class: 'payout' };
            } else if (type.includes('Refund')) {
                return { icon: 'fas fa-undo', class: 'refund' };
            } else {
                return { icon: 'fas fa-exchange-alt', class: 'other' };
            }
        }

        function getStatusClass(status) {
            status = status.toLowerCase();
            if (status === 'completed') return 'completed';
            if (status === 'pending') return 'pending';
            if (status === 'failed') return 'failed';
            return '';
        }

        function closeTransactionModal() {
            document.getElementById('transactionModal').style.display = 'none';
            document.body.style.overflow = 'auto';
            document.getElementById('modalBody').innerHTML = `
                <div class="modal-loader">
                    <i class="fas fa-spinner"></i>
                    <p>Loading transaction details...</p>
                </div>
            `;
        }

        // Close modal when clicking outside
        window.onclick = function(event) {
            const modal = document.getElementById('transactionModal');
            if (event.target === modal) {
                closeTransactionModal();
            }
        }

        // Close modal with Escape key
        document.addEventListener('keydown', function(event) {
            if (event.key === 'Escape') {
                closeTransactionModal();
            }
        });
    </script>
}