@model MyAspNetApp.Models.LandingPageViewModel

@{
    ViewData["Title"] = "Home";
    Layout = "_LoginLandingLayout";
    var isLoggedIn = Context.Session.GetInt32("UserId") != null
        || !string.IsNullOrWhiteSpace(Context.Request.Cookies["NextHorizon.SharedUserId"]);
    var allProducts = Model.Products ?? new List<Product>();
    var footwearProducts = allProducts
        .Where(IsFootwearProduct)
        .DefaultIfEmpty()
        .Where(p => p is not null)
        .Cast<Product>()
        .ToList();
    if (footwearProducts.Count == 0)
    {
        footwearProducts = allProducts.Take(12).ToList();
    }

    var apparelProducts = allProducts
        .Where(IsApparelProduct)
        .DefaultIfEmpty()
        .Where(p => p is not null)
        .Cast<Product>()
        .ToList();
    if (apparelProducts.Count == 0)
    {
        apparelProducts = allProducts.Skip(footwearProducts.Count).Take(12).ToList();
        if (apparelProducts.Count == 0)
        {
            apparelProducts = allProducts.Take(12).ToList();
        }
    }
}

