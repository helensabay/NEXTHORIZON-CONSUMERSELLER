<script>
const landingRequiresLogin = @Html.Raw((!isLoggedIn).ToString().ToLowerInvariant());

function buildLandingLoginUrl() {
    const returnUrl = window.location.pathname + window.location.search + window.location.hash;
    return `/Account/Login?returnUrl=${encodeURIComponent(returnUrl)}`;
}

function requireLoginForLandingAction(event) {
    if (!landingRequiresLogin) {
        return false;
    }

    if (event) {
        event.preventDefault();
        event.stopPropagation();
    }

    window.location.href = buildLandingLoginUrl();
    return true;
}

function landingQuickView(image, name, brand, price, category, sku, sizes, stock) {
    if (requireLoginForLandingAction()) {
        return;
    }

    openQuickView(image, name, brand, price, category, sku, sizes, stock);
}

let heroIndex = 0;
let heroTotal = @promoImages.Length;
let heroTimer = null;

function heroGoTo(index) {
    heroIndex = index;
    document.getElementById('heroTrack').style.transform = `translateX(-${heroIndex * 100}%)`;
    const dots = document.getElementById('heroDots').querySelectorAll('button');
    dots.forEach((d, i) => {
        d.style.width      = i === heroIndex ? '24px' : '8px';
        d.style.background = i === heroIndex ? 'white' : 'rgba(255,255,255,0.4)';
    });
    resetHeroTimer();
}

function heroSlide(dir) {
    heroGoTo((heroIndex + dir + heroTotal) % heroTotal);
}

function resetHeroTimer() {
    clearInterval(heroTimer);
    heroTimer = setInterval(() => heroSlide(1), 4000);
}

resetHeroTimer();

document.addEventListener("DOMContentLoaded", function() {
    const sliders = document.querySelectorAll('.product-auto-slider');

    sliders.forEach(slider => {
        let scrollAmount = 0;
        const step = 300; // Width of card + gap

        setInterval(() => {
            const maxScroll = slider.scrollWidth - slider.parentElement.clientWidth;
            
            if (scrollAmount >= maxScroll) {
                scrollAmount = 0; // Reset to start
            } else {
                scrollAmount += step;
            }
            
            slider.style.transform = `translateX(-${scrollAmount}px)`;
        }, 3000); // 3 seconds interval
    });
});

function filterByGender(gender, element) {
    // highlight active tab
    document.querySelectorAll('.tab-btn').forEach(btn => btn.classList.remove('active'));
    element.classList.add('active');

    const cards = document.querySelectorAll('#gender-slider-track .small-product-card');

    cards.forEach(card => {
        const productGender = (card.dataset.gender || "Unisex").trim().toLowerCase();
        const targetGender = gender.toLowerCase();

        if (targetGender === 'all' || productGender === targetGender) {
            card.style.display = "block";
        } else {
            card.style.display = "none";
        }
    });

    // reset slider position
    currentScroll = 0;
    document.getElementById('gender-slider-track').style.transform = "translateX(0px)";
}
let currentScroll = 0;

function addToCart(productId) {
    if (requireLoginForLandingAction()) {
        return;
    }

    window.location.href = "http://localhost:5297/Home/Shop";
}



// Leaderboard
// Leaderboard
const API_URL = '/Home/GetLeaderboard?scope=All&take=100';
const MEDALS = ["🥇", "🥈", "🥉"];
let leaderboardExpanded = false;

function fmt(sec) {
    const m = Math.floor(sec / 60), s = sec % 60;
    return m + "m " + String(s).padStart(2, "0") + "s";
}
function initials(n) {
    return n.split(" ").map(w => w[0]).join("").substring(0, 2).toUpperCase();
}

function runnerRow(r, i) {
    return `
        <div style="display:flex;align-items:center;gap:10px;padding:10px 0;border-bottom:1px solid rgba(255,255,255,0.07);">
            <span style="font-size:16px;width:22px;text-align:center;">${i < 3 ? MEDALS[i] : i + 1}</span>
            <div style="width:30px;height:30px;border-radius:50%;background:#1a2e45;display:flex;align-items:center;justify-content:center;font-size:11px;font-weight:600;color:#64b5f6;flex-shrink:0;">
                ${initials(r.athleteName)}
            </div>
            <div style="flex:1;min-width:0;">
                <div style="font-size:13px;font-weight:600;color:#fff;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">${r.athleteName}</div>
                <div style="font-size:11px;color:rgba(255,255,255,0.35);">${new Date(r.activityDate).toLocaleDateString("en-US",{month:"short",day:"numeric"})}</div>
            </div>
            <div style="text-align:right;flex-shrink:0;">
                <div style="font-size:13px;font-weight:600;color:#fff;">${parseFloat(r.distanceKm).toFixed(2)} km</div>
                <div style="font-size:11px;color:rgba(255,255,255,0.35);">${fmt(r.durationSeconds)}</div>
            </div>
        </div>`;
}

function toggleLeaderboard() {
    leaderboardExpanded = !leaderboardExpanded;
    const expanded = document.getElementById("leaderboard-expanded");
    const btn = document.getElementById("see-more-btn");

    if (leaderboardExpanded) {
        expanded.style.display = "block";
        btn.innerHTML = "SEE LESS ▴";
    } else {
        expanded.style.display = "none";
        btn.innerHTML = "SEE MORE ▾";
    }
}

async function loadLeaderboard() {
    try {
        const res = await fetch(API_URL);
        if (!res.ok) throw new Error();
        const data = await res.json();

        const top3 = document.getElementById("leaderboard-top3");
        const rest = document.getElementById("leaderboard-rest");
        const btn  = document.getElementById("see-more-btn");

        if (!data.length) {
            top3.innerHTML = '<p style="color:rgba(255,255,255,0.4);font-size:13px;text-align:center;margin-top:40px;">No runners yet.</p>';
            return;
        }

        // Always show top 3
        top3.innerHTML = data.slice(0, 3).map((r, i) => runnerRow(r, i)).join("");

        // Show "See More" only if there are more than 3
        if (data.length > 3) {
            rest.innerHTML = data.slice(3).map((r, i) => runnerRow(r, i + 3)).join("");
            btn.style.display = "block";
        } else {
            btn.style.display = "none";
        }

    } catch {
        document.getElementById("leaderboard-top3").innerHTML =
            '<p style="color:rgba(255,255,255,0.4);font-size:13px;text-align:center;margin-top:40px;">Could not load leaderboard.</p>';
    }
}

loadLeaderboard();
setInterval(loadLeaderboard, 30000);


// Fetch and inject promotions into carousel
async function loadPromotions() {
    try {
        const res = await fetch('/Home/GetPromotions');
        const promos = await res.json();
        if (!promos.length) return;

        const track = document.getElementById('heroTrack');
        const dotsContainer = document.getElementById('heroDots');

        promos.forEach(p => {
            const discountText = p.type === 'Fix Amount'
                ? `₱${p.totalDiscountFix} OFF`
                : `${p.totalDiscountPercent}% OFF`;

            const minText = p.minimumPurchaseAmount > 0
                ? `Min. purchase of ₱${p.minimumPurchaseAmount}` : '';

            const slide = document.createElement('div');
            slide.style.cssText = 'min-width:100%; position:relative; height:calc(100vh - 56px); flex-shrink:0; background:linear-gradient(135deg,#1a1a1a,#2d2d2d); display:flex; align-items:center;';
            slide.innerHTML = `
                <div style="position:absolute; inset:0; background:linear-gradient(to right, rgba(0,0,0,0.8) 0%, rgba(0,0,0,0.3) 60%, transparent 100%);"></div>
                <div style="position:relative; z-index:1; left:7%;">
                    <p style="color:rgba(255,255,255,0.7); font-size:13px; letter-spacing:3px; text-transform:uppercase; margin:0 0 10px;">LIMITED OFFER</p>
                    <h1 style="color:white; font-size:clamp(2rem,4vw,3.2rem); font-weight:800; text-transform:uppercase; margin:0 0 10px; line-height:1.1;">${p.name}</h1>
                    <div style="font-size:clamp(1.5rem,3vw,2.5rem); font-weight:800; color:#e74c3c; margin:10px 0;">${discountText}</div>
                    ${minText ? `<p style="color:rgba(255,255,255,0.7); font-size:14px; margin:0 0 28px;">${minText}</p>` : '<div style="margin-bottom:28px;"></div>'}
                    <a href="/Account/Login" style="display:inline-block; background:white; color:#111; padding:12px 32px; font-weight:700; font-size:13px; letter-spacing:2px; text-transform:uppercase; text-decoration:none; border-radius:2px;">SHOP NOW</a>
                </div>`;

            track.appendChild(slide);

            // Add dot
            const dotIndex = track.children.length - 1;
            const dot = document.createElement('button');
            dot.style.cssText = 'width:8px; height:8px; border-radius:4px; border:none; cursor:pointer; transition:all 0.3s; background:rgba(255,255,255,0.4); padding:0;';
            dot.onclick = () => heroGoTo(dotIndex);
            dotsContainer.appendChild(dot);
        });

        // Update heroTotal to include promo slides
        heroTotal = track.children.length;

    } catch(e) {
        console.error('Failed to load promotions', e);
    }
}

loadPromotions();


</script>

@functions {
    private static bool IsFootwearProduct(Product product)
    {
        var text = $"{product.Category} {product.SubCategory} {product.Name}";
        return text.Contains("shoe", StringComparison.OrdinalIgnoreCase)
            || text.Contains("footwear", StringComparison.OrdinalIgnoreCase)
            || text.Contains("runner", StringComparison.OrdinalIgnoreCase)
            || text.Contains("sneaker", StringComparison.OrdinalIgnoreCase);
    }

    private static bool IsApparelProduct(Product product)
    {
        var text = $"{product.Category} {product.SubCategory} {product.Name}";
        return text.Contains("shirt", StringComparison.OrdinalIgnoreCase)
            || text.Contains("tee", StringComparison.OrdinalIgnoreCase)
            || text.Contains("singlet", StringComparison.OrdinalIgnoreCase)
            || text.Contains("tank", StringComparison.OrdinalIgnoreCase)
            || text.Contains("apparel", StringComparison.OrdinalIgnoreCase);
    }

    private static string ProductImageSrc(string? image)
    {
        if (string.IsNullOrWhiteSpace(image))
        {
            return "/images/shop-hero-shoe.avif";
        }

        var trimmed = image.Trim();
        if (trimmed.StartsWith("http://", StringComparison.OrdinalIgnoreCase)
            || trimmed.StartsWith("https://", StringComparison.OrdinalIgnoreCase)
            || trimmed.StartsWith("/", StringComparison.Ordinal))
        {
            return trimmed;
        }

        return "/uploads/products/" + trimmed.TrimStart('~', '/', '\\');
    }
}
