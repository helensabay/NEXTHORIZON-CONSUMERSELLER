@section Scripts {
<script src="~/Messaging/js/StorefrontMessaging.js" asp-append-version="true"></script>
<script>
const SELLER_ID = @sellerId;
let currentChatSeller = null;
let currentChatUserId = null;
let currentSellerShop = null;
let isFollowing = false;
let csrfTokenPromise = null;

document.addEventListener('DOMContentLoaded', function() {
    loadSellerShop(SELLER_ID);
});

async function loadSellerShop(id) {
    try {
        const [sellerRes, productsRes] = await Promise.all([
            fetch(`/api/sellers/${id}`),
            fetch(`/api/products/seller/${id}`)
        ]);
        if (!sellerRes.ok) throw new Error('Seller not found');
        const seller = await sellerRes.json();
        const products = await productsRes.json();
        renderSellerShop(seller, products);
    } catch(e) {
        document.getElementById('seller-shop-loading').innerHTML =
            '<p style="color:#888;text-align:center;padding:4rem;">Shop not found. <a href="/Home/Shop">Back to Shop</a></p>';
    }
}

function renderSellerShop(seller, products) {
    document.getElementById('seller-shop-loading').style.display = 'none';
    document.getElementById('seller-shop-content').style.display = 'block';
    document.title = `${seller.shopName} - NEXT HORIZON`;

    window.sellerShopMessengerUrl = `/consumer/messenger/?sellerId=${seller.id}&embed=chat`;

    // Promo banner
    document.getElementById('seller-promo-img').src = seller.coverImage;
    document.getElementById('seller-promo-img').alt = seller.shopName + ' promotion';

    // Profile
    document.getElementById('seller-shop-avatar').src = seller.avatar;
    document.getElementById('seller-shop-avatar').alt = seller.shopName;
    document.getElementById('seller-shop-name').textContent = seller.shopName;
    document.getElementById('seller-shop-loc-text').textContent = seller.location;
    document.getElementById('seller-shop-joined-text').textContent = seller.joinedAgo;
    document.getElementById('seller-shop-description').textContent = seller.description;
    document.getElementById('seller-messenger-name').textContent = seller.shopName;
    document.getElementById('sellerShopChatTitle').textContent = seller.shopName;
    currentChatSeller = seller;
    currentSellerShop = seller;

    // Stats
    document.getElementById('ss-products-count').textContent = seller.totalProducts;
    document.getElementById('ss-followers-count').textContent = formatShopCount(seller.followers);
    document.getElementById('ss-rating-value').textContent = seller.rating.toFixed(1);
    document.getElementById('ss-ratings-count').textContent = formatShopCount(seller.totalRatings);
    document.getElementById('ss-response-rate').textContent = seller.responseRate + '%';
    isFollowing = Boolean(seller.isFollowing);
    syncFollowButton();

    // Products
    document.getElementById('ss-products-total').textContent = `(${products.length} items)`;

    if (products.length === 0) {
        document.getElementById('seller-shop-empty').style.display = 'flex';
        return;
    }

    const grid = document.getElementById('seller-shop-products-grid');
    grid.innerHTML = products.map(p => {
        const hasDiscount = p.originalPrice && p.originalPrice > p.price;
        const discountPct = hasDiscount ? Math.round((1 - p.price / p.originalPrice) * 100) : 0;
        return `
        <div class="ss-product-card" onclick="window.location.href='/Home/Product?id=${p.id}'">
            <div class="ss-product-card-img">
                <img src="${p.image}" alt="${p.name}" loading="lazy"
                    onerror="this.src='data:image/svg+xml,%3Csvg xmlns=%27http://www.w3.org/2000/svg%27 width=%27300%27 height=%27300%27%3E%3Crect width=%27300%27 height=%27300%27 fill=%27%23fafafa%27/%3E%3C/svg%3E'">
                ${hasDiscount ? `<span class="ss-product-badge-sale">-${discountPct}%</span>` : ''}
                ${p.stock === 0 && !p.isPreOrder && !p.isRestockPreOrder ? '<span class="ss-product-badge-soldout">Sold Out</span>' : ''}
                ${p.isPreOrder ? '<span class="ss-product-badge-preorder">Pre-Order</span>' : ''}
                <div class="ss-product-card-overlay">View Product</div>
            </div>
            <div class="ss-product-card-body">
                <p class="ss-product-brand">${p.brand}</p>
                <h4 class="ss-product-name">${p.name}</h4>
                <div class="ss-product-price-row">
                    ${hasDiscount
                        ? `<span class="ss-product-price-sale">${formatShopPeso(p.price)}</span><span class="ss-product-price-original">${formatShopPeso(p.originalPrice)}</span>`
                        : `<span class="ss-product-price">${formatShopPeso(p.price)}</span>`
                    }
                </div>
                <div class="ss-product-rating">
                    <span class="stars">${getShopStars(p.rating)}</span>
                    <span class="ss-product-rating-count">(${p.reviewCount})</span>
                </div>
            </div>
        </div>`;
    }).join('');
}

function formatShopCount(n) {
    if (n >= 1000) return (n / 1000).toFixed(1).replace(/\.0$/, '') + 'k';
    return n.toString();
}

function formatFollowerTimestamp(value) {
    const date = new Date(value);
    if (Number.isNaN(date.getTime())) return '';
    return `Followed ${date.toLocaleDateString('en-PH', { month: 'short', day: 'numeric', year: 'numeric' })}`;
}

async function getCsrfToken() {
    if (!csrfTokenPromise) {
        csrfTokenPromise = fetch('/api/security/csrf-token', { credentials: 'same-origin' })
            .then(async response => {
                const payload = await response.json().catch(() => ({}));
                if (!response.ok) {
                    throw new Error(payload.message || 'Unable to prepare follow request.');
                }
                return payload.token || '';
            })
            .catch(error => {
                csrfTokenPromise = null;
                throw error;
            });
    }

    return csrfTokenPromise;
}

function syncFollowButton() {
    const btn = document.getElementById('seller-shop-follow-btn');
    if (!btn) return;

    if (isFollowing) {
        btn.classList.add('following');
        btn.innerHTML = `
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"/></svg>
            Following`;
        return;
    }

    btn.classList.remove('following');
    btn.innerHTML = `
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="8.5" cy="7" r="4"/><line x1="20" y1="8" x2="20" y2="14"/><line x1="23" y1="11" x2="17" y2="11"/></svg>
        Follow`;
}

async function openFollowersModal() {
    const modal = document.getElementById('followers-modal');
    const title = document.getElementById('followers-modal-title');
    const summary = document.getElementById('followers-modal-summary');
    const list = document.getElementById('followers-modal-list');
    if (!modal || !summary || !list) return;

    modal.hidden = false;
    title.textContent = `${currentSellerShop?.shopName || 'Seller'} Followers`;
    summary.textContent = 'Loading followers...';
    list.innerHTML = '';

    try {
        const response = await fetch(`/api/sellers/${SELLER_ID}/followers`, { credentials: 'same-origin' });
        const payload = await response.json().catch(() => ({}));
        if (!response.ok) {
            throw new Error(payload.message || 'Unable to load followers.');
        }

        const items = Array.isArray(payload.items) ? payload.items : [];
        summary.textContent = `${payload.count || items.length} follower${(payload.count || items.length) === 1 ? '' : 's'}`;

        if (!items.length) {
            list.innerHTML = '<div class="followers-modal-empty">No followers yet.</div>';
            return;
        }

        list.innerHTML = items.map(item => `
            <div class="follower-row">
                <img class="follower-avatar" src="${escapeHtml(item.avatar || '')}" alt="${escapeHtml(item.displayName || 'Follower')}">
                <div class="follower-body">
                    <div class="follower-name">${escapeHtml(item.displayName || 'Follower')}</div>
                    <div class="follower-meta">${escapeHtml(formatFollowerTimestamp(item.followedAt))}</div>
                </div>
            </div>
        `).join('');
    } catch (error) {
        summary.textContent = 'Followers unavailable';
        list.innerHTML = `<div class="followers-modal-empty">${escapeHtml(error.message || 'Unable to load followers.')}</div>`;
    }
}

function closeFollowersModal() {
    const modal = document.getElementById('followers-modal');
    if (modal) modal.hidden = true;
}

function formatShopPeso(amount) {
    return '₱' + Number(amount).toLocaleString('en-PH', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
}

function getShopStars(rating) {
    let html = '';
    for (let i = 1; i <= 5; i++) {
        if (rating >= i) html += '<span class="star filled">★</span>';
        else if (rating >= i - 0.5) html += '<span class="star half">★</span>';
        else html += '<span class="star">★</span>';
    }
    return html;
}

function ensureSellerShopChatHead() {
    const container = document.getElementById('sellerShopChatHeadContainer');
    if (!container || container.childElementCount) return;

    const button = document.createElement('button');
    button.type = 'button';
    button.className = 'chat-head';
    button.textContent = 'S';
    button.setAttribute('aria-label', 'Open seller chat');
    button.addEventListener('click', function () {
        sellerShopChat();
    });
    container.appendChild(button);
}

function ensureSellerShopChatFrame() {
    const frame = document.getElementById('sellerShopChatFrame');
    const targetUrl = window.sellerShopMessengerUrl || `/consumer/messenger/?sellerId=${SELLER_ID}&embed=chat`;
    if (!frame) return;

    const absoluteTargetUrl = new URL(targetUrl, window.location.origin).href;
    if (frame.src !== absoluteTargetUrl) {
        frame.src = targetUrl;
    }
}

function sellerShopChat() {
    try {
        ensureSellerShopChatFrame();
        const modal = document.getElementById('sellerShopChatModal');
        if (!modal) return;
        modal.classList.add('active');
        modal.setAttribute('aria-hidden', 'false');
        document.getElementById('sellerShopChatHeadContainer')?.replaceChildren();
    } catch (error) {
        console.error('Error opening chat:', error);
    }
}

window.closeSellerShopChat = function () {
    const modal = document.getElementById('sellerShopChatModal');
    if (!modal) return;
    modal.classList.remove('active');
    modal.setAttribute('aria-hidden', 'true');
    document.getElementById('sellerShopChatHeadContainer')?.replaceChildren();
};

window.sendSellerShopMessage = function () {
    ensureSellerShopChatFrame();
};

window.minimizeSellerShopChat = function () {
    const modal = document.getElementById('sellerShopChatModal');
    if (!modal) return;
    modal.classList.remove('active');
    modal.setAttribute('aria-hidden', 'true');
    ensureSellerShopChatHead();
};

function closeSellerMessenger() {
    const messengerView = document.getElementById('seller-messenger-view');
    messengerView.classList.remove('active');
    setTimeout(() => {
        messengerView.style.display = 'none';
    }, 300);
}

// Messenger functionality
let messengerState = {
    currentUserId: null,
    quickActions: [],
    selectedFaqId: null,
    isSending: false
};

async function loadSellerQuickActions() {
    const quickActionsScroller = document.getElementById('quick-actions-scroller');
    quickActionsScroller.innerHTML = '<div class="quick-actions-placeholder">Loading quick actions...</div>';
    setMessengerStatus('Loading');

    try {
        const url = `/api/storefront-chat/conversation?sellerId=${SELLER_ID}`;
        const response = await fetch(url, { credentials: 'same-origin' });
        const payload = await response.json();

        if (!response.ok) {
            throw new Error(payload.message || 'Unable to load quick actions.');
        }

        messengerState.currentUserId = String(payload.currentUserId || '');
        messengerState.quickActions = Array.isArray(payload.faqs) ? payload.faqs : [];
        renderSellerQuickActions();
        setMessengerStatus(messengerState.quickActions.length ? 'Ready' : 'No FAQs');
    } catch (error) {
        quickActionsScroller.innerHTML = `<div class="quick-actions-placeholder">${escapeHtml(error.message || 'Unable to load quick actions.')}</div>`;
        setMessengerStatus('Unavailable');
    }
}

function renderSellerQuickActions() {
    const quickActionsScroller = document.getElementById('quick-actions-scroller');
    const actionOptions = document.getElementById('seller-action-options');
    
    if (!messengerState.quickActions.length) {
        quickActionsScroller.innerHTML = '<div class="quick-actions-placeholder">No active FAQs were found for this account.</div>';
        setComposerState(null);
        if (actionOptions) actionOptions.classList.remove('is-hidden');
        return;
    }

    messengerState.selectedFaqId = messengerState.quickActions[0].faqId;
    quickActionsScroller.innerHTML = '';

    messengerState.quickActions.forEach((faq, index) => {
        const button = document.createElement('button');
        button.type = 'button';
        button.className = `quick-action-chip${index === 0 ? ' is-active' : ''}`;
        button.dataset.faqId = String(faq.faqId);
        button.textContent = faq.question || 'Untitled FAQ';
        button.title = faq.question || 'Untitled FAQ';
        button.addEventListener('click', () => handleSellerQuickActionClick(faq.faqId));
        quickActionsScroller.appendChild(button);
    });

    setComposerState(messengerState.quickActions[0]);
    // Hide action options when FAQs are loaded
    if (actionOptions) actionOptions.classList.add('is-hidden');
}

function handleSellerQuickActionClick(faqId) {
    const faq = messengerState.quickActions.find(item => item.faqId === faqId);
    if (!faq) return;

    messengerState.selectedFaqId = faqId;
    document.querySelectorAll('#quick-actions-scroller .quick-action-chip').forEach((chip) => {
        chip.classList.toggle('is-active', chip.dataset.faqId === String(faqId));
    });

    setComposerState(faq);
    requestAnimationFrame(() => {
        submitSellerQuickAction();
    });
}

async function submitSellerQuickAction() {
    if (!messengerState.selectedFaqId || messengerState.isSending) return;

    messengerState.isSending = true;
    const sendButton = document.getElementById('messenger-send-btn');
    const thread = document.getElementById('messenger-thread');
    
    sendButton.disabled = true;
    sendButton.classList.remove('is-ready');
    sendButton.classList.add('is-sending');
    sendButton.textContent = 'Sending...';
    thread.classList.add('is-loading');
    setMessengerStatus('Sending');

    try {
        const response = await fetch('/api/storefront-chat/faq-click', {
            method: 'POST',
            credentials: 'same-origin',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ sellerId: SELLER_ID, faqId: messengerState.selectedFaqId })
        });
        const payload = await response.json();

        if (!response.ok) {
            throw new Error(payload.message || 'Unable to send quick action.');
        }

        messengerState.currentUserId = String(payload.currentUserId || messengerState.currentUserId || '');
        thread.classList.remove('is-loading');
        renderSellerMessages(Array.isArray(payload.messages) ? payload.messages : []);
        setMessengerStatus('Sent');
        
        setTimeout(() => {
            setMessengerStatus('Ready');
        }, 1200);
    } catch (error) {
        thread.classList.remove('is-loading');
        renderSellerError(error.message || 'Unable to send quick action.');
        setMessengerStatus('Retry');
    } finally {
        messengerState.isSending = false;
        sendButton.textContent = 'Auto Send';
        sendButton.classList.remove('is-sending');
        setComposerState(messengerState.quickActions.find(item => item.faqId === messengerState.selectedFaqId) || null);
    }
}

function renderSellerMessages(messages) {
    const thread = document.getElementById('messenger-thread');
    const actionOptions = document.getElementById('seller-action-options');
    thread.innerHTML = '';

    if (!messages.length) {
        thread.innerHTML = `
            <div class="messenger-empty">
                <strong>No messages yet.</strong>
                <span>Select a quick action above to start the conversation.</span>
            </div>`;
        return;
    }

    // Hide action options when messages are present
    if (actionOptions) actionOptions.classList.add('is-hidden');

    const fragment = document.createDocumentFragment();
    messages.forEach((message) => {
        const row = document.createElement('div');
        const isUser = String(message.senderUserId) === messengerState.currentUserId;
        row.className = `messenger-bubble-row ${isUser ? 'is-user' : 'is-seller'}`;

        const bubble = document.createElement('div');
        bubble.className = 'messenger-bubble';
        bubble.textContent = message.isDeleted ? '[message deleted]' : (message.body || '');
        row.appendChild(bubble);
        fragment.appendChild(row);
    });
    
    thread.appendChild(fragment);
    
    requestAnimationFrame(() => {
        thread.scrollTo({
            top: thread.scrollHeight,
            behavior: 'smooth'
        });
    });
}

function renderSellerError(message) {
    const thread = document.getElementById('messenger-thread');
    const actionOptions = document.getElementById('seller-action-options');
    thread.innerHTML = `
        <div class="messenger-empty">
            <strong>Message failed.</strong>
            <span>${escapeHtml(message)}</span>
        </div>`;
    // Keep action options visible on error
    if (actionOptions) actionOptions.classList.remove('is-hidden');
}

function setComposerState(faq) {
    const input = document.getElementById('messenger-input');
    const sendButton = document.getElementById('messenger-send-btn');
    input.value = faq?.question || '';
    const ready = Boolean(faq?.faqId);
    sendButton.disabled = !ready || messengerState.isSending;
    sendButton.classList.toggle('is-ready', ready && !messengerState.isSending);
}

function setMessengerStatus(text) {
    const statusPill = document.getElementById('messenger-status-pill');
    if (statusPill) statusPill.textContent = text;
}

// Toggle quick actions visibility
document.addEventListener('DOMContentLoaded', () => {
    const quickActionsToggle = document.getElementById('quick-actions-toggle');
    const quickActionsBody = document.getElementById('quick-actions-body');
    
    if (quickActionsToggle && quickActionsBody) {
        quickActionsToggle.addEventListener('click', () => {
            const isHidden = quickActionsBody.classList.toggle('is-hidden');
            quickActionsToggle.textContent = isHidden ? 'Show' : 'Hide';
            quickActionsToggle.setAttribute('aria-expanded', String(!isHidden));
        });
    }
    
    // Close messenger with Escape key
    document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') {
            const messengerView = document.getElementById('seller-messenger-view');
            if (messengerView && messengerView.classList.contains('active')) {
                closeSellerMessenger();
            }
        }
    });

    // Attach robust click handler to Chat Now button and log for debugging
    try {
        const chatBtn = document.querySelector('.seller-profile-btn-chat');
        if (chatBtn) {
            // remove any existing temporary listener to avoid duplicates
            chatBtn.removeEventListener('click', chatBtn._debugClickHandler);
            const handler = function (ev) {
                console.log('Chat Now button clicked (debug listener)');
                try { sellerShopChat(); } catch (err) { console.error('sellerShopChat error:', err); }
            };
            chatBtn.addEventListener('click', handler);
            // keep reference so it can be removed later
            chatBtn._debugClickHandler = handler;
        } else {
            console.warn('Chat Now button not found for debug listener');
        }
    } catch (e) {
        console.error('Error attaching chat debug listener', e);
    }

    const followersTrigger = document.getElementById('seller-followers-trigger');
    if (followersTrigger) {
        followersTrigger.addEventListener('click', openFollowersModal);
        followersTrigger.addEventListener('keydown', function (event) {
            if (event.key === 'Enter' || event.key === ' ') {
                event.preventDefault();
                openFollowersModal();
            }
        });
    }
});

function escapeHtml(value) {
    return String(value)
        .replaceAll('&', '&amp;')
        .replaceAll('<', '&lt;')
        .replaceAll('>', '&gt;')
        .replaceAll('"', '&quot;')
        .replaceAll("'", '&#39;');
}

function closeSellerChat() {
    window.closeSellerShopChat();
}

function formatShopPeso(amount) {
    return '\u20B1' + Number(amount).toLocaleString('en-PH', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
}

function getShopStars(rating) {
    let html = '';
    for (let i = 1; i <= 5; i++) {
        if (rating >= i) html += '<span class="star filled">&#9733;</span>';
        else if (rating >= i - 0.5) html += '<span class="star half">&#9733;</span>';
        else html += '<span class="star">&#9733;</span>';
    }
    return html;
}

async function toggleFollow() {
    const btn = document.getElementById('seller-shop-follow-btn');
    if (!btn) return;

    const nextState = !isFollowing;
    btn.disabled = true;

    try {
        const csrfToken = await getCsrfToken();
        const response = await fetch(`/api/sellers/${SELLER_ID}/follow`, {
            method: 'POST',
            credentials: 'same-origin',
            headers: {
                'Content-Type': 'application/json',
                'X-CSRF-TOKEN': csrfToken
            },
            body: JSON.stringify({ follow: nextState })
        });

        const payload = await response.json().catch(() => ({}));
        if (response.status === 401) {
            throw new Error('You must log in first to follow this shop.');
        }
        if (!response.ok) {
            throw new Error(payload.message || 'Unable to update follow status.');
        }

        isFollowing = Boolean(payload.isFollowing);
        if (currentSellerShop) {
            currentSellerShop.followers = Number(payload.followers || 0);
        }
        document.getElementById('ss-followers-count').textContent = formatShopCount(Number(payload.followers || 0));
        syncFollowButton();

        if (typeof toast !== 'undefined') {
            if (isFollowing) toast.success('You are now following this shop.');
            else toast.info('Unfollowed this shop.');
        }
    } catch (error) {
        if (typeof toast !== 'undefined') {
            toast.info(error.message || 'Unable to update follow status.');
        }
    } finally {
        btn.disabled = false;
    }
}

</script>
}


