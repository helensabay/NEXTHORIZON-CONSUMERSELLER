@{
    ViewData["Title"] = "Seller Shop";
    var sellerId = ViewData["SellerId"];
}

<div class="seller-shop-page" id="seller-shop-page">

    <!-- Loading State -->
    <div class="seller-shop-loading" id="seller-shop-loading">
        <div class="loading-spinner"></div>
        <p>Loading shop…</p>
    </div>

    <!-- Shop Content -->
    <div id="seller-shop-content" style="display:none;">

        <!-- Unified Profile Bar (avatar + info + stats + actions in one row) -->
        <div class="seller-profile-bar">
            <div class="container">
                <div class="seller-profile-bar-inner">
                    <!-- Left: Avatar + Identity -->
                    <div class="seller-profile-left">
                        <img class="seller-profile-avatar" id="seller-shop-avatar" src="" alt="" />
                        <div class="seller-profile-identity">
                            <h1 class="seller-profile-name" id="seller-shop-name"></h1>
                            <div class="seller-profile-meta">
                                <span class="seller-profile-meta-item">
                                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
                                    <span id="seller-shop-loc-text"></span>
                                </span>
                                <span class="seller-profile-meta-dot">·</span>
                                <span class="seller-profile-meta-item">Joined <span id="seller-shop-joined-text"></span></span>
                            </div>
                        </div>
                    </div>

                    <!-- Center: Inline Stats -->
                    <div class="seller-profile-stats">
                        <div class="seller-profile-stat">
                            <span class="seller-profile-stat-num" id="ss-products-count"></span>
                            <span class="seller-profile-stat-lbl">Products</span>
                        </div>
                        <div class="seller-profile-stat seller-profile-stat-followers" id="seller-followers-trigger" role="button" tabindex="0" aria-label="View followers">
                            <span class="seller-profile-stat-num" id="ss-followers-count"></span>
                            <span class="seller-profile-stat-lbl">Followers</span>
                        </div>
                        <div class="seller-profile-stat">
                            <span class="seller-profile-stat-num" id="ss-rating-value"></span>
                            <span class="seller-profile-stat-lbl">Rating</span>
                        </div>
                        <div class="seller-profile-stat">
                            <span class="seller-profile-stat-num" id="ss-ratings-count"></span>
                            <span class="seller-profile-stat-lbl">Ratings</span>
                        </div>
                        <div class="seller-profile-stat">
                            <span class="seller-profile-stat-num" id="ss-response-rate"></span>
                            <span class="seller-profile-stat-lbl">Response</span>
                        </div>
                    </div>

                    <!-- Right: Actions -->
                    <div class="seller-profile-actions">
                        <button class="seller-profile-btn seller-profile-btn-chat" onclick="sellerShopChat()">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
                            Chat Now
                        </button>
                        <button class="seller-profile-btn seller-profile-btn-follow" id="seller-shop-follow-btn" onclick="toggleFollow()">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="8.5" cy="7" r="4"/><line x1="20" y1="8" x2="20" y2="14"/><line x1="23" y1="11" x2="17" y2="11"/></svg>
                            Follow
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Description -->
        <div class="seller-shop-about container">
            <div class="seller-shop-about-card">
                <h3>About This Shop</h3>
                <p id="seller-shop-description"></p>
            </div>
        </div>

        <!-- Promotions Banner -->
        <div class="seller-promo-section container">
            <a href="#" class="seller-promo-banner" id="seller-promo-banner">
                <img id="seller-promo-img" src="" alt="Shop Promotion" />
            </a>
        </div>

        <!-- Products -->
        <div class="seller-shop-products container">
            <div class="seller-shop-products-header">
                <h2>All Products</h2>
                <span class="seller-shop-products-count" id="ss-products-total"></span>
            </div>
            <div class="seller-shop-products-grid" id="seller-shop-products-grid">
                <!-- Filled by JS -->
            </div>
            <div class="seller-shop-empty" id="seller-shop-empty" style="display:none;">
                <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="2"/><line x1="3" y1="9" x2="21" y2="9"/><line x1="9" y1="21" x2="9" y2="9"/></svg>
                <p>This shop doesn't have any products yet.</p>
            </div>
        </div>
    </div>

    <!-- Full Messenger View -->
    <div class="seller-messenger-view" id="seller-messenger-view" style="display:none;">
        <div class="messenger-page" data-seller-id="@sellerId">
            <section class="messenger-shell">
                <header class="messenger-topbar">
                    <div class="messenger-topbar-content">
                        <button type="button" class="messenger-back-btn" onclick="closeSellerMessenger()">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
                            Back to Shop
                        </button>
                        <div class="messenger-topbar-text">
                            <p class="messenger-eyebrow">Chat with Seller</p>
                            <h1 class="messenger-title" id="seller-messenger-name"></h1>
                        </div>
                    </div>
                    <p class="messenger-subtle">Quick replies send common FAQs into the chat.</p>
                </header>

                <!-- Seller Action Options -->
                <section class="seller-action-options" id="seller-action-options">
                    <div class="seller-action-card">
                        <div class="seller-action-icon">💬</div>
                        <div class="seller-action-content">
                            <h3>Talk with the Seller</h3>
                            <p>Send quick FAQs or custom messages</p>
                        </div>
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 18l6-6-6-6"/></svg>
                    </div>
                    <div class="seller-action-card">
                        <div class="seller-action-icon">📦</div>
                        <div class="seller-action-content">
                            <h3>Send Product</h3>
                            <p>Recommend a product to seller</p>
                        </div>
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 18l6-6-6-6"/></svg>
                    </div>
                </section>

                <section class="quick-actions-card" id="quick-actions-card">
                    <div class="quick-actions-head">
                        <span class="quick-actions-label">QUICK ACTIONS</span>
                        <button type="button" class="quick-actions-toggle" id="quick-actions-toggle" aria-expanded="true">Hide</button>
                    </div>
                    <div class="quick-actions-body" id="quick-actions-body">
                        <div class="quick-actions-scroller" id="quick-actions-scroller" aria-live="polite"></div>
                    </div>
                </section>

                <section class="messenger-thread-card">
                    <div class="messenger-thread-header">
                        <div>
                            <h2 class="messenger-thread-title">Conversation</h2>
                            <p class="messenger-thread-copy">Tap a quick action to send it as a message.</p>
                        </div>
                        <span class="messenger-pill" id="messenger-status-pill">Ready</span>
                    </div>

                    <div class="messenger-thread" id="messenger-thread">
                        <div class="messenger-empty">
                            <strong>No messages yet.</strong>
                            <span>Select a quick action above to start the conversation.</span>
                        </div>
                    </div>

                    <div class="messenger-composer">
                        <label class="messenger-composer-label" for="messenger-input">Message preview</label>
                        <div class="messenger-composer-box">
                            <textarea id="messenger-input" class="messenger-input" rows="2" placeholder="Choose a quick action above" readonly></textarea>
                            <button type="button" class="messenger-send-btn" id="messenger-send-btn" disabled>Auto Send</button>
                        </div>
                    </div>
                </section>
            </section>
        </div>
    </div>
</div>

<div class="followers-modal" id="followers-modal" hidden>
    <div class="followers-modal-backdrop" onclick="closeFollowersModal()"></div>
    <div class="followers-modal-dialog" role="dialog" aria-modal="true" aria-labelledby="followers-modal-title">
        <div class="followers-modal-header">
            <div>
                <p class="followers-modal-eyebrow">Seller Community</p>
                <h3 id="followers-modal-title">Followers</h3>
            </div>
            <button type="button" class="followers-modal-close" onclick="closeFollowersModal()" aria-label="Close followers list">×</button>
        </div>
        <div class="followers-modal-summary" id="followers-modal-summary">Loading followers...</div>
        <div class="followers-modal-list" id="followers-modal-list"></div>
    </div>
</div>

<style>
    .seller-shop-page {
        min-height: 100vh;
        padding: 28px 0 64px;
        background:
            radial-gradient(circle at top left, rgba(0, 0, 0, 0.04), transparent 28%),
            linear-gradient(180deg, #ffffff 0%, #f5f5f5 100%);
    }

    .seller-shop-loading {
        min-height: 55vh;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 14px;
        color: #64748b;
        text-transform: uppercase;
        letter-spacing: .08em;
        font-size: .82rem;
    }

    .seller-profile-bar {
        margin-bottom: 24px;
    }

    .seller-profile-bar-inner {
        display: grid;
        grid-template-columns: minmax(260px, 1.15fr) minmax(340px, 1fr) auto;
        align-items: center;
        gap: 24px;
        padding: 28px 30px;
        background: rgba(255, 255, 255, .98);
        border: 1px solid rgba(0, 0, 0, .12);
        border-radius: 30px;
        box-shadow: 0 22px 44px rgba(0, 0, 0, .08);
        backdrop-filter: blur(12px);
    }

    .seller-profile-left {
        display: flex;
        align-items: center;
        gap: 18px;
        min-width: 0;
    }

    .seller-profile-avatar {
        width: 88px;
        height: 88px;
        border-radius: 999px;
        object-fit: cover;
        background: #e5e5e5;
        border: 4px solid #fff;
        box-shadow: 0 14px 26px rgba(0, 0, 0, .14);
        flex-shrink: 0;
    }

    .seller-profile-identity {
        min-width: 0;
    }

    .seller-profile-name {
        margin: 0 0 8px;
        font-family: "Space Grotesk", "Inter", sans-serif;
        font-size: clamp(1.9rem, 2.8vw, 2.6rem);
        line-height: 1.02;
        letter-spacing: -.04em;
        color: #111;
    }

    .seller-profile-meta {
        display: flex;
        align-items: center;
        gap: 10px;
        flex-wrap: wrap;
        color: #555;
        font-size: .92rem;
    }

    .seller-profile-meta-item {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        min-width: 0;
    }

    .seller-profile-meta-item svg {
        color: #111;
        flex-shrink: 0;
    }

    .seller-profile-meta-dot {
        color: #999;
        font-weight: 700;
    }

    .seller-profile-stats {
        display: grid;
        grid-template-columns: repeat(5, minmax(0, 1fr));
        gap: 12px;
        min-width: 0;
    }

    .seller-profile-stat {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 5px;
        min-height: 84px;
        padding: 14px 10px;
        text-align: center;
        border-radius: 22px;
        background: linear-gradient(180deg, #ffffff 0%, #f6f6f6 100%);
        border: 1px solid rgba(0, 0, 0, .08);
        box-shadow: inset 0 1px 0 rgba(255,255,255,.75);
    }

    .seller-profile-stat-num {
        font-family: "Space Grotesk", "Inter", sans-serif;
        font-size: 1.28rem;
        font-weight: 700;
        color: #111;
        letter-spacing: -.03em;
    }

    .seller-profile-stat-lbl {
        font-size: .74rem;
        font-weight: 700;
        letter-spacing: .12em;
        text-transform: uppercase;
        color: #666;
    }

    .seller-profile-actions {
        display: flex;
        align-items: center;
        justify-content: flex-end;
        gap: 12px;
        flex-wrap: wrap;
    }

    .seller-profile-btn {
        min-height: 46px;
        padding: 0 18px;
        border-radius: 999px;
        border: 1px solid #0f172a;
        background: #fff;
        color: #111;
        font-size: .82rem;
        font-weight: 700;
        letter-spacing: .08em;
        text-transform: uppercase;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 9px;
        cursor: pointer;
        transition: transform .2s ease, box-shadow .2s ease, background-color .2s ease, color .2s ease, border-color .2s ease;
        white-space: nowrap;
    }

    .seller-profile-btn:hover {
        transform: translateY(-1px);
        box-shadow: 0 12px 24px rgba(0, 0, 0, .12);
    }

    .seller-profile-btn-chat {
        background: #111;
        border-color: #111;
        color: #fff;
    }

    .seller-profile-btn-chat:hover {
        background: #2b2b2b;
        color: #fff;
    }

    .seller-profile-btn-follow.following {
        background: #111;
        border-color: #111;
        color: #fff;
    }

    .seller-profile-btn:disabled {
        opacity: .7;
        cursor: wait;
        transform: none;
    }

    .seller-shop-about,
    .seller-promo-section,
    .seller-shop-products {
        margin-top: 22px;
    }

    .seller-shop-about-card {
        padding: 28px 30px;
        border-radius: 28px;
        background: rgba(255,255,255,.96);
        border: 1px solid rgba(0, 0, 0, .12);
        box-shadow: 0 18px 36px rgba(0, 0, 0, .06);
    }

    .seller-shop-about-card h3 {
        margin: 0 0 12px;
        font-family: "Space Grotesk", "Inter", sans-serif;
        font-size: 1.2rem;
        color: #111;
    }

    .seller-shop-about-card p {
        margin: 0;
        max-width: 78ch;
        color: #444;
        line-height: 1.7;
        font-size: .98rem;
    }

    .seller-promo-banner {
        display: block;
        overflow: hidden;
        border-radius: 30px;
        border: 1px solid rgba(0, 0, 0, .12);
        box-shadow: 0 20px 40px rgba(0, 0, 0, .08);
        background: #e5e5e5;
    }

    .seller-promo-banner img {
        display: block;
        width: 100%;
        aspect-ratio: 16 / 5;
        object-fit: cover;
        filter: grayscale(1);
    }

    .seller-shop-products-header {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        gap: 18px;
        margin-bottom: 20px;
    }

    .seller-shop-products-header h2 {
        margin: 0;
        font-family: "Space Grotesk", "Inter", sans-serif;
        font-size: clamp(1.5rem, 2.3vw, 2rem);
        letter-spacing: -.03em;
        color: #111;
    }

    .seller-shop-products-count {
        color: #666;
        font-size: .92rem;
        font-weight: 600;
    }

    .seller-shop-products-grid {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 24px;
    }

    .ss-product-card {
        overflow: hidden;
        border-radius: 24px;
        background: #fff;
        border: 1px solid rgba(0, 0, 0, .12);
        box-shadow: 0 16px 34px rgba(0, 0, 0, .06);
        cursor: pointer;
        transition: transform .28s ease, box-shadow .28s ease, border-color .28s ease;
    }

    .ss-product-card:hover {
        transform: translateY(-6px);
        box-shadow: 0 24px 46px rgba(0, 0, 0, .12);
        border-color: rgba(0, 0, 0, .28);
    }

    .ss-product-card-img {
        position: relative;
        overflow: hidden;
        background: #f4f4f4;
        aspect-ratio: 4 / 5;
    }

    .ss-product-card-img img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
        transition: transform .45s ease;
        filter: grayscale(1);
    }

    .ss-product-card:hover .ss-product-card-img img {
        transform: scale(1.05);
    }

    .ss-product-card-overlay {
        position: absolute;
        inset: auto 0 0 0;
        padding: 14px 18px;
        background: rgba(255,255,255,.94);
        border-top: 1px solid rgba(0, 0, 0, .1);
        color: #111;
        font-size: .74rem;
        font-weight: 800;
        letter-spacing: .16em;
        text-transform: uppercase;
        text-align: center;
        transform: translateY(100%);
        transition: transform .24s ease;
    }

    .ss-product-card:hover .ss-product-card-overlay {
        transform: translateY(0);
    }

    .ss-product-badge-sale,
    .ss-product-badge-soldout,
    .ss-product-badge-preorder {
        position: absolute;
        left: 14px;
        z-index: 2;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 28px;
        padding: 0 10px;
        border-radius: 999px;
        font-size: .7rem;
        font-weight: 800;
        letter-spacing: .08em;
        text-transform: uppercase;
    }

    .ss-product-badge-sale {
        top: 14px;
        background: #111;
        color: #fff;
    }

    .ss-product-badge-soldout {
        top: 50px;
        background: rgba(0, 0, 0, .82);
        color: #fff;
    }

    .ss-product-badge-preorder {
        top: 50px;
        background: #444;
        color: #fff;
    }

    .ss-product-card-body {
        padding: 18px 18px 20px;
        display: flex;
        flex-direction: column;
        gap: 10px;
    }

    .ss-product-brand {
        margin: 0;
        font-size: .72rem;
        font-weight: 800;
        letter-spacing: .14em;
        text-transform: uppercase;
        color: #666;
    }

    .ss-product-name {
        margin: 0;
        font-size: 1rem;
        line-height: 1.45;
        color: #111;
    }

    .ss-product-price-row {
        display: flex;
        align-items: baseline;
        gap: 8px;
        flex-wrap: wrap;
    }

    .ss-product-price,
    .ss-product-price-sale {
        font-family: "Space Grotesk", "Inter", sans-serif;
        font-size: 1.05rem;
        font-weight: 700;
        color: #111;
    }

    .ss-product-price-original {
        color: #8a8a8a;
        font-size: .88rem;
        text-decoration: line-through;
    }

    .ss-product-rating {
        display: flex;
        align-items: center;
        gap: 8px;
        color: #666;
        font-size: .84rem;
    }

    .stars {
        display: inline-flex;
        gap: 2px;
        color: #cfcfcf;
        font-size: .95rem;
        line-height: 1;
    }

    .star.filled,
    .star.half {
        color: #111;
    }

    .seller-shop-empty {
        margin-top: 8px;
        min-height: 260px;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 14px;
        text-align: center;
        border-radius: 28px;
        background: rgba(255,255,255,.95);
        border: 1px solid rgba(0, 0, 0, .12);
        color: #555;
        padding: 32px 20px;
    }

    .seller-shop-empty p {
        margin: 0;
        font-size: 1rem;
    }

    .seller-messenger-view {
        position: fixed;
        inset: 0;
        background: radial-gradient(circle at top right, rgba(15,118,110,.10), transparent 28%), radial-gradient(circle at top left, rgba(15,23,42,.06), transparent 25%), linear-gradient(180deg, #f8fafc 0%, #eef2f7 100%);
        z-index: 1100;
        overflow-y: auto;
        display: flex;
        flex-direction: column;
        animation: fadeIn .3s ease;
    }
    .seller-messenger-view.active {
        display: flex;
    }
    @@keyframes fadeIn {
        from { opacity: 0; }
        to { opacity: 1; }
    }
    .messenger-page {
        min-height: calc(100vh - 220px);
        padding: 32px 18px 56px;
    }
    .messenger-shell {
        width: min(100%, 1040px);
        margin: 0 auto;
        display: flex;
        flex-direction: column;
        gap: 20px;
    }
    .messenger-topbar, .quick-actions-card, .messenger-thread-card {
        background: rgba(255,255,255,.92);
        border: 1px solid rgba(148,163,184,.22);
        border-radius: 28px;
        box-shadow: 0 24px 54px rgba(15,23,42,.08);
        backdrop-filter: blur(14px);
    }
    .messenger-topbar {
        padding: 26px 28px;
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        justify-content: flex-start;
        gap: 12px;
    }
    .messenger-topbar-content {
        display: flex;
        align-items: center;
        gap: 16px;
        width: 100%;
    }
    .messenger-topbar-text {
        flex: 1;
    }
    .messenger-back-btn {
        border: 0;
        background: transparent;
        color: #0f172a;
        font-size: .95rem;
        font-weight: 600;
        cursor: pointer;
        padding: 8px 12px;
        border-radius: 8px;
        display: flex;
        align-items: center;
        gap: 8px;
        transition: background-color .2s ease, color .2s ease;
        white-space: nowrap;
    }
    .messenger-back-btn:hover {
        background-color: #f1f5f9;
        color: #0f172a;
    }

    .seller-profile-stat-followers {
        cursor: pointer;
    }
    .seller-profile-stat-followers:focus-visible {
        outline: 2px solid #0f766e;
        outline-offset: 4px;
        border-radius: 18px;
    }
    .followers-modal {
        position: fixed;
        inset: 0;
        z-index: 1400;
    }
    .followers-modal[hidden] {
        display: none;
    }
    .followers-modal-backdrop {
        position: absolute;
        inset: 0;
        background: rgba(15, 23, 42, .45);
        backdrop-filter: blur(4px);
    }
    .followers-modal-dialog {
        position: relative;
        width: min(520px, calc(100vw - 32px));
        max-height: min(680px, calc(100vh - 32px));
        margin: 16px auto;
        background: #fff;
        border-radius: 28px;
        box-shadow: 0 24px 64px rgba(15, 23, 42, .22);
        display: flex;
        flex-direction: column;
        overflow: hidden;
    }
