  .pg .hero-divider{display:none}
  .pg .lb-row{grid-template-columns:30px 1fr repeat(3,70px);padding:0.8rem}
  .pg .ht-row{grid-template-columns:1fr;gap:8px}
}
</style>

<div class="pg">
  @if (TempData["ChallengeJoinSuccess"] is string challengeJoinSuccess)
  {
    <div class="challenge-join-status is-visible" style="margin-bottom:1rem">@challengeJoinSuccess</div>
  }
  @if (TempData["ChallengeJoinError"] is string challengeJoinError)
  {
    <div class="challenge-join-status is-visible" style="margin-bottom:1rem;border-color:#f1c5c5;background:#fff6f6;color:#8f1d1d">@challengeJoinError</div>
  }
  @if (TempData["ChallengeActivitySuccess"] is string challengeActivitySuccess)
  {
    <div class="challenge-join-status is-visible" style="margin-bottom:1rem">@challengeActivitySuccess</div>
  }
  @if (TempData["ChallengeActivityError"] is string challengeActivityError)
  {
    <div class="challenge-join-status is-visible" style="margin-bottom:1rem;border-color:#f1c5c5;background:#fff6f6;color:#8f1d1d">@challengeActivityError</div>
  }

  <div class="pg-header">
    <h1 id="pg-title">Challenges</h1>
    <span class="pg-header-sub" id="pg-sub">@Model.SeasonLabel &nbsp;·&nbsp; @Model.ActiveCount Active</span>
  </div>

  <div class="pg-tabs">
    <button class="pg-tab active" type="button" onclick="switchTab('challenges', this)">Challenges</button>
    <button class="pg-tab" type="button" onclick="switchTab('vouchers', this)">MY REWARDS</button>
    <button class="pg-tab" type="button" onclick="switchTab('activities', this)">Challenge Participation</button>
  </div>

  <div class="tab-panel active" id="tab-challenges">
    <div class="hero">
      <div class="hero-stat">
        <div class="hero-stat-num">@Model.TotalParticipants.ToString("N0")</div>
        <div class="hero-stat-label">Runners Competing</div>
      </div>
      <div class="hero-divider"></div>
      <div class="hero-stat">
        <div class="hero-stat-num">@Model.TotalGoalKm.ToString("N1")</div>
        <div class="hero-stat-label">Total Goal KM</div>
      </div>
      <div class="hero-divider"></div>
      <div class="hero-stat">
        <div class="hero-stat-num">@Model.DaysUntilNextDrop</div>
        <div class="hero-stat-label">Days Until Next Drop</div>
      </div>
    </div>

    <div class="section-row">
      <span class="section-label">Featured challenge</span>
      <span class="section-tag">Live now</span>
    </div>

    @if (hasFeatured)
    {
      <div class="featured" style="margin-bottom:3rem">
        <div class="feat-main @(featured!.HasBannerImage ? "has-banner" : string.Empty)" style="@(featured.HasBannerImage ? $"background-image:linear-gradient(rgba(0,0,0,.56),rgba(0,0,0,.56)),url('/Home/ChallengeBanner/{featured.ChallengeId}')" : string.Empty)">
          <div class="feat-main-ghost">RUN</div>
          <span class="feat-badge">&#9679; Live</span>
          <h2>@featured.Title</h2>
          <p>@featured.Description</p>
          <div class="feat-meta">
            <div class="feat-meta-item">
              <span class="feat-meta-val">@featured.DurationDays days</span>
              <span class="feat-meta-key">Duration</span>
            </div>
            <div class="feat-meta-item">
              <span class="feat-meta-val">@featured.GoalKm.ToString("N1") km</span>
              <span class="feat-meta-key">Goal</span>
            </div>
            <div class="feat-meta-item">
              <span class="feat-meta-val">@featured.TotalParticipants.ToString("N0")</span>
              <span class="feat-meta-key">Joined</span>
            </div>
          </div>
          <button type="button" class="join-challenge-btn" data-join-challenge data-challenge-id="@featured.ChallengeId" data-challenge-title="@featured.Title">Join Challenge</button>
        </div>
        <div class="feat-side">
          <div class="feat-side-top">
            <p class="card-badge" style="margin-bottom:8px">Reward</p>
            <h3>@featured.ActivityType</h3>
            <p>@featured.Prizes</p>
          </div>
          <div class="feat-side-stat">
            <div class="feat-side-stat-row">
              <span>Completion rate</span>
              <span>@featured.CompletionPercent.ToString("N0")%</span>
            </div>
          </div>
          <div class="feat-side-stat" style="border-bottom:none">
            <div class="feat-side-stat-row">
              <span>Completed</span>
              <span>@featured.TotalCompleted.ToString("N0")</span>
            </div>
          </div>
          <div class="feat-progress">
            <div class="feat-progress-label">
              <span>Community progress</span>
              <span>@featured.CompletionPercent.ToString("N0")% avg completion</span>
            </div>
            <div class="feat-progress-bar"><div class="feat-progress-fill" style="width:@featured.CompletionPercent%"></div></div>
          </div>
          <div class="challenge-mini-leaderboard">
            <div class="challenge-mini-head">
              <span>Challenge Leaderboard</span>
              <span>Rank</span>
            </div>
            @if (featured.LeaderboardEntries.Any())
            {
              <div class="challenge-mini-list">
                @foreach (var entry in featured.LeaderboardEntries)
                {
                  <div class="challenge-mini-row">
                    <div class="challenge-mini-rank">#@entry.Rank</div>
                    <div class="challenge-mini-user">
                      <img src="@entry.AvatarUrl" class="challenge-mini-avatar" alt="@entry.AthleteName" />
                      <div>
                        <div class="challenge-mini-name">@entry.AthleteName</div>
                        <div class="challenge-mini-meta">Challenge rank @entry.Rank</div>
                      </div>
                    </div>
                    <div class="challenge-mini-stat">
                      <div class="challenge-mini-distance">@entry.DistanceDisplay</div>
                      <div class="challenge-mini-time">@entry.DurationDisplay</div>
                    </div>
                  </div>
                }
              </div>
            }
            else
            {
              <div class="challenge-mini-empty">No ranked participants yet.</div>
            }
          </div>
        </div>
      </div>
    }
    else
    {
      <div class="empty-state" style="margin-bottom:3rem">No challenges found in database yet.</div>
    }

    <div class="section-row upcoming-head">
      <span class="section-label">Open and upcoming challenges</span>
      <span class="section-tag">Join now</span>
    </div>

    @if (Model.UpcomingChallenges.Any())
    {
      <div class="grid3 upcoming-grid">
        @for (var i = 0; i < Model.UpcomingChallenges.Count; i++)
        {
          var item = Model.UpcomingChallenges[i];
          var isLive =
            (item.StartDate <= DateTime.Now && item.EndDate >= DateTime.Now) ||
            string.Equals(item.Status, "live", StringComparison.OrdinalIgnoreCase) ||
            string.Equals(item.Status, "active", StringComparison.OrdinalIgnoreCase);
          var isUpcoming =
            item.StartDate > DateTime.Now ||
            string.Equals(item.Status, "upcoming", StringComparison.OrdinalIgnoreCase);
          <article class="card">
            <div class="card-accent"></div>
            @if (item.HasBannerImage)
            {
              <div class="card-banner">
                <img src="/Home/ChallengeBanner/@item.ChallengeId" alt="@item.Title banner" loading="lazy" />
              </div>
            }
            <div class="card-meta-row">
              <span class="card-badge">@(isLive ? "Live now" : isUpcoming ? $"Coming {item.StartDate:MMM d}" : $"Ended {item.EndDate:MMM d}")</span>
              <span class="card-diff @item.DifficultyCssClass">@item.DifficultyLabel</span>
            </div>
            <h3>@item.Title</h3>
            <p>@item.Description</p>
            <div class="card-footer">
              <span class="card-footer-stat">Duration <strong>@item.DurationDays days</strong></span>
              <span class="card-num">@((i + 1).ToString("D2"))</span>
            </div>
            <div class="challenge-mini-leaderboard" style="margin:1rem -1.5rem -1.75rem;padding:1rem 1.5rem 1.25rem">
              <div class="challenge-mini-head">
                <span>Challenge Leaderboard</span>
                <span>Rank</span>
              </div>
              @if (item.LeaderboardEntries.Any())
              {
                <div class="challenge-mini-list">
                  @foreach (var entry in item.LeaderboardEntries)
                  {
                    <div class="challenge-mini-row">
                      <div class="challenge-mini-rank">#@entry.Rank</div>
                      <div class="challenge-mini-user">
                        <img src="@entry.AvatarUrl" class="challenge-mini-avatar" alt="@entry.AthleteName" />
                        <div>
                          <div class="challenge-mini-name">@entry.AthleteName</div>
                          <div class="challenge-mini-meta">Challenge rank @entry.Rank</div>
                        </div>
                      </div>
                      <div class="challenge-mini-stat">
                        <div class="challenge-mini-distance">@entry.DistanceDisplay</div>
                        <div class="challenge-mini-time">@entry.DurationDisplay</div>
                      </div>
                    </div>
                  }
                </div>
              }
              else
              {
                <div class="challenge-mini-empty">No ranked participants yet.</div>
              }
            </div>
            <button type="button" class="card-join-btn" data-join-challenge data-challenge-id="@item.ChallengeId" data-challenge-title="@item.Title">Join Challenge</button>
          </article>
        }
      </div>
    }
    else
    {
      <div class="empty-state" style="margin-bottom:3rem">No live or upcoming challenges right now.</div>
    }

    <div class="section-row upcoming-head">
      <span class="section-label">Completed challenges</span>
      <span class="section-tag">Finished events</span>
    </div>

    @if (Model.CompletedChallenges.Any())
    {
      <div class="grid3 upcoming-grid">
        @for (var i = 0; i < Model.CompletedChallenges.Count; i++)
        {
          var item = Model.CompletedChallenges[i];
          <article class="card">
            <div class="card-accent"></div>
            @if (item.HasBannerImage)
            {
              <div class="card-banner">
                <img src="/Home/ChallengeBanner/@item.ChallengeId" alt="@item.Title banner" loading="lazy" />
              </div>
            }
            <div class="card-meta-row">
              <span class="card-badge">Ended @item.EndDate.ToString("MMM d")</span>
              <span class="card-diff @item.DifficultyCssClass">@item.DifficultyLabel</span>
            </div>
            <h3>@item.Title</h3>
            <p>@item.Description</p>
            <div class="card-footer">
              <span class="card-footer-stat">Completed <strong>@item.TotalCompleted.ToString("N0")</strong></span>
              <span class="card-num">@((i + 1).ToString("D2"))</span>
            </div>
            <div class="challenge-mini-leaderboard" style="margin:1rem -1.5rem -1.75rem;padding:1rem 1.5rem 1.25rem">
              <div class="challenge-mini-head">
                <span>Challenge Leaderboard</span>
                <span>Rank</span>
              </div>
              @if (item.LeaderboardEntries.Any())
              {
                <div class="challenge-mini-list">
                  @foreach (var entry in item.LeaderboardEntries)
                  {
                    <div class="challenge-mini-row">
                      <div class="challenge-mini-rank">#@entry.Rank</div>
                      <div class="challenge-mini-user">
                        <img src="@entry.AvatarUrl" class="challenge-mini-avatar" alt="@entry.AthleteName" />
                        <div>
                          <div class="challenge-mini-name">@entry.AthleteName</div>
                          <div class="challenge-mini-meta">Challenge rank @entry.Rank</div>
                        </div>
                      </div>
                      <div class="challenge-mini-stat">
                        <div class="challenge-mini-distance">@entry.DistanceDisplay</div>
                        <div class="challenge-mini-time">@entry.DurationDisplay</div>
                      </div>
                    </div>
                  }
                </div>
              }
              else
              {
                <div class="challenge-mini-empty">No ranked participants yet.</div>
              }
            </div>
          </article>
        }
      </div>
    }
    else
    {
      <div class="empty-state" style="margin-bottom:3rem">No completed challenges yet.</div>
    }

    <div class="section-row leaderboard-head">
      <span class="section-label">Challenge Performance</span>
      <span class="section-tag">Top challenges</span>
    </div>

    @if (Model.TopChallenges.Any())
    {
      <div class="leaderboard">
        <div class="lb-row lb-header">
          <span class="lb-rank">#</span>
          <span class="lb-name">Challenge</span>
          <span class="lb-val">Goal KM</span>
          <span class="lb-val">Completed</span>
          <span class="lb-val">Participants</span>
        </div>
        @for (var i = 0; i < Model.TopChallenges.Count; i++)
        {
          var row = Model.TopChallenges[i];
          var avatarText = string.IsNullOrWhiteSpace(row.ActivityType) ? "CH" : row.ActivityType[..Math.Min(2, row.ActivityType.Length)].ToUpperInvariant();
          <div class="lb-row">
            <span class="lb-rank @(i < 3 ? "top" : string.Empty)">@(i + 1)</span>
            <div class="lb-name-wrap"><span class="lb-avatar">@avatarText</span><div><div class="lb-name">@row.Title</div><div class="lb-handle">@row.Status</div></div></div>
            <span class="lb-val bold">@row.GoalKm.ToString("N1") km</span>
            <span class="lb-val">@row.TotalCompleted.ToString("N0")</span>
            <span class="lb-val">@row.TotalParticipants.ToString("N0")</span>
          </div>
        }
      </div>
    }
    else
    {
      <div class="empty-state">No challenge performance data available.</div>
    }
  </div>

  <div class="tab-panel" id="tab-vouchers">
    <div class="hero hero-4">
      <div class="hero-stat">
        <div class="hero-stat-num">@activeVouchers.Count</div>
        <div class="hero-stat-label">Active</div>
      </div>
      <div class="hero-divider"></div>
      <div class="hero-stat">
        <div class="hero-stat-num">@usedVouchers.Count</div>
        <div class="hero-stat-label">Redeemed</div>
      </div>
      <div class="hero-divider"></div>
      <div class="hero-stat">
        <div class="hero-stat-num">@expiredVouchers.Count</div>
        <div class="hero-stat-label">Expired</div>
      </div>
      <div class="hero-divider"></div>
      <div class="hero-stat">
        <div class="hero-stat-num">@totalSavedDisplay</div>
        <div class="hero-stat-label">Total Saved</div>
      </div>
    </div>

    <div class="section-row">
      <span class="section-label" style="font-size:16px;letter-spacing:0.08em;color:#111;font-weight:700;">Active Vouchers</span>
      <span class="section-tag">Ready to use</span>
    </div>

    @if (activeVouchers.Any())
    {
      <div class="voucher-grid">
        @foreach (var voucher in activeVouchers)
        {
          var expiringSoon = voucher.ExpiryDate <= DateTime.Now.AddDays(7);
          <div class="voucher-card">
            <div class="voucher-stub stub-active"></div>
            <div class="voucher-body">
              <div class="voucher-top">
                <span class="voucher-type">@voucher.VoucherType</span>
                <span class="status-pill pill-active">&#9679; Active</span>
              </div>
              <div class="voucher-value">@voucher.DisplayValue</div>
              <div class="voucher-title">@voucher.Title</div>
              <div class="voucher-desc">@voucher.Description</div>
              <hr class="voucher-tear" />
              <div class="voucher-footer">
                <span class="voucher-code">@voucher.Code</span>
                <span class="voucher-expiry @(expiringSoon ? "expiry-soon" : string.Empty)">Exp @voucher.ExpiryDate.ToString("MMM d, yyyy")</span>
              </div>
            </div>
          </div>
        }
      </div>
    }
    else
    {
      <div class="empty-state-center">
        <span class="empty-icon">NONE</span>
        <p>No active vouchers - earn them by completing challenges</p>
      </div>
    }

    @if (usedVouchers.Any() || expiredVouchers.Any())
    {
      <div class="section-row" style="margin-top:0.5rem">
        <span class="section-label" style="font-size:16px;letter-spacing:0.08em;color:#111;font-weight:700;">Voucher History</span>
        <span class="section-tag">Used &amp; Expired</span>
      </div>
      <div class="history-table">
        <div class="ht-row ht-header">
          <span>Voucher</span>
          <span>Code</span>
          <span style="text-align:right">Date</span>
          <span style="text-align:right">Status</span>
        </div>
        @foreach (var voucher in usedVouchers)
        {
          <div class="ht-row">
            <div>
              <div class="ht-name">@voucher.Title <span style="font-size:12px;color:#bbb;font-weight:300">· @voucher.DisplayValue</span></div>
              <div class="ht-sub">@voucher.VoucherType</div>
            </div>
            <span class="ht-code">@voucher.Code</span>
            <span class="ht-date">@voucher.RedeemedDate?.ToString("MMM d, yyyy")</span>
            <span class="ht-badge badge-used">Redeemed</span>
          </div>
        }
        @foreach (var voucher in expiredVouchers)
        {
          <div class="ht-row">
            <div>
              <div class="ht-name" style="color:#ccc">@voucher.Title <span style="font-size:12px;font-weight:300">· @voucher.DisplayValue</span></div>
              <div class="ht-sub" style="color:#ddd">@voucher.VoucherType</div>
            </div>
            <span class="ht-code" style="color:#ddd">@voucher.Code</span>
            <span class="ht-date" style="color:#ddd">Exp @voucher.ExpiryDate.ToString("MMM d, yyyy")</span>
            <span class="ht-badge badge-expired">Expired</span>
          </div>
        }
      </div>
    }
  </div>

  <div class="tab-panel" id="tab-activities">
    <div class="hero hero-4">
      <button type="button" class="hero-stat is-clickable is-active" id="joinedChallengesFilterBtn">
        <div class="hero-stat-num">@Model.MyActivitiesCount</div>
        <div class="hero-stat-label">Joined Challenges</div>
      </button>
      <div class="hero-divider"></div>
      <button type="button" class="hero-stat is-clickable" id="approvedChallengesFilterBtn">
        <div class="hero-stat-num">@Model.ApprovedActivitiesCount</div>
        <div class="hero-stat-label">Approved</div>
      </button>
      <div class="hero-divider"></div>
      <button type="button" class="hero-stat is-clickable" id="pendingChallengesFilterBtn">
        <div class="hero-stat-num">@Model.PendingActivitiesCount</div>
        <div class="hero-stat-label">Pending</div>
      </button>
      <div class="hero-divider"></div>
      <button type="button" class="hero-stat is-clickable" id="withUploadsFilterBtn">
        <div class="hero-stat-num">@uploadedActivities.Count</div>
        <div class="hero-stat-label">With Uploads</div>
      </button>
    </div>

    <div class="section-row">
      <span class="section-label" style="font-size:16px;letter-spacing:0.08em;color:#111;font-weight:700;">Challenge Participation</span>
      <span class="section-tag">Status Driven</span>
    </div>
    <div class="activity-summary-note">Each card shows the challenge you joined. Pending participants only see status. Approved participants can open the member-style activity upload form.</div>
    <div class="activity-filter-row" id="activityFilterRow" style="display:none;">
      <span class="section-tag" id="activityFilterLabel" style="border-bottom:none;padding-bottom:0">Showing all uploaded activities</span>
      <button type="button" class="activity-filter-reset" id="resetActivityFilterBtn">Show All</button>
    </div>

    @if (myActivities.Any())
    {
      <div class="activity-grid" id="challengeParticipationGrid">
        @foreach (var activity in myActivities)
        {
          <article class="activity-card" data-total-activities="@activity.TotalActivities" data-status="@activity.Status">
            <div class="activity-media">
              <span class="activity-media-empty">@activity.ActivityType</span>
            </div>
            <div class="activity-body">
              <div class="activity-head">
                <div>
                  <div class="activity-type">@activity.ActivityType</div>
                  <div class="activity-title">@activity.ChallengeTitle</div>
                  <div class="activity-date">@activity.GoalDisplay</div>
                </div>
                <span class="activity-badge @(activity.CanUpload ? "ok" : "pending")">@activity.StatusLabel</span>
              </div>

              <div class="activity-notes">@activity.ChallengeDescription</div>

              <div class="activity-metrics">
                <div class="activity-metric">
                  <div class="activity-metric-label">Uploads</div>
                  <div class="activity-metric-value">@activity.TotalActivities</div>
                </div>
                <div class="activity-metric">
                  <div class="activity-metric-label">Distance</div>
                  <div class="activity-metric-value">@activity.TotalDistanceDisplay</div>
                </div>
                <div class="activity-metric">
                  <div class="activity-metric-label">Time</div>
                  <div class="activity-metric-value">@activity.TotalTimeDisplay</div>
                </div>
                <div class="activity-metric">
                  <div class="activity-metric-label">Last Activity</div>
                  <div class="activity-metric-value">@activity.LastActivityDisplay</div>
                </div>
              </div>

              <div class="activity-notes">@activity.Notes</div>

              <div class="activity-actions">
                @if (activity.CanUpload)
                {
                  <button
                    type="button"
                    class="activity-upload-btn"
                    data-open-activity-upload
                    data-participant-id="@activity.ParticipantId"
                    data-challenge-id="@activity.ChallengeId"
                    data-challenge-title="@activity.ChallengeTitle"
                    data-activity-type="@activity.ActivityType">Upload Activity</button>
                }
                else
                {
                  <span class="section-tag" style="border-bottom:none;padding-bottom:0">@(activity.IsExpired ? "Closed" : "Awaiting Approval")</span>
                }
              </div>
            </div>
          </article>
        }
      </div>
    }
    else
    {
      <div class="empty-state-center">
        <span class="empty-icon">RUN</span>
        <p>No joined challenges yet. Join a challenge first, then this tab will show whether your participation is pending or approved.</p>
      </div>
    }

    <div id="uploadedActivitiesGrid" style="display:none;">
      @if (uploadedActivities.Any())
      {
        <div class="activity-grid">
          @foreach (var upload in uploadedActivities)
          {
            <article class="activity-card">
              <div class="activity-media">
                @if (upload.HasProofImage)
                {
                  <img src="@upload.ProofImageUrl" alt="@upload.ChallengeTitle proof image" />
                }
                else
                {
                  <span class="activity-media-empty">@upload.ActivityType</span>
                }
              </div>
              <div class="activity-body">
                <div class="activity-head">
                  <div>
                    <div class="activity-type">@upload.ActivityType</div>
                    <div class="activity-title">@upload.ChallengeTitle</div>
                    <div class="activity-date">@upload.ActivityDateDisplay</div>
                  </div>
                  <span class="activity-badge @upload.VerificationCssClass">@upload.VerificationLabel</span>
                </div>

                <div class="activity-notes">@upload.Notes</div>

                <div class="activity-metrics">
                  <div class="activity-metric">
                    <div class="activity-metric-label">Distance</div>
                    <div class="activity-metric-value">@upload.DistanceDisplay</div>
                  </div>
                  <div class="activity-metric">
                    <div class="activity-metric-label">Duration</div>
                    <div class="activity-metric-value">@upload.DurationDisplay</div>
                  </div>
                  <div class="activity-metric">
                    <div class="activity-metric-label">Average Pace</div>
                    <div class="activity-metric-value">@upload.AveragePaceDisplay</div>
                  </div>
                  <div class="activity-metric">
                    <div class="activity-metric-label">Status</div>
                    <div class="activity-metric-value">@upload.VerificationLabel</div>
                  </div>
                </div>

                <div class="activity-actions">
                  @if (upload.HasProofImage)
                  {
                    <button
                      type="button"
                      class="activity-proof-link"
                      data-open-proof-preview
                      data-proof-url="@upload.ProofImageUrl"
                      data-proof-title="@upload.ChallengeTitle proof image">View Proof</button>
                  }
                  else
                  {
                    <span class="section-tag" style="border-bottom:none;padding-bottom:0">No Proof Image</span>
                  }
                </div>
              </div>
            </article>
          }
        </div>
      }
      else
      {
        <div class="empty-state-center">
          <span class="empty-icon">LOG</span>
          <p>No uploaded activity records yet. Once you submit an approved challenge activity, it will appear here.</p>
        </div>
      }
    </div>
  </div>
</div>

<div class="challenge-join-modal" id="activityUploadModal" aria-hidden="true">
  <div class="challenge-join-panel" role="dialog" aria-modal="true" aria-labelledby="activityUploadTitle">
    <div class="challenge-join-head">
      <div>
        <div class="challenge-join-title" id="activityUploadTitle">Upload Activity</div>
        <div class="challenge-join-sub">This form follows the member upload activity flow for approved challenge participants.</div>
      </div>
      <button type="button" class="challenge-join-close" id="activityUploadClose" aria-label="Close">&times;</button>
    </div>
    <form id="activityUploadForm" method="post" enctype="multipart/form-data" asp-controller="Home" asp-action="UploadChallengeActivity">
      @Html.AntiForgeryToken()
      <input type="hidden" name="ParticipantId" id="activityParticipantId" />
      <input type="hidden" name="ChallengeId" id="activityChallengeId" />
      <div class="challenge-join-grid">
        <div class="challenge-join-field challenge-join-field--full">
          <label class="challenge-join-label" for="activityChallengeName">Challenge</label>
          <input class="challenge-join-input" id="activityChallengeName" type="text" readonly />
        </div>
        <div class="challenge-join-field">
          <label class="challenge-join-label" for="activityTypeInput">Activity Type</label>
          <select class="challenge-join-input" id="activityTypeInput" name="ActivityType" required>
            <option value="Run">Run</option>
            <option value="Walk">Walk</option>
            <option value="Ride">Ride</option>
            <option value="Hike">Hike</option>
          </select>
        </div>
        <div class="challenge-join-field">
          <label class="challenge-join-label" for="activityDateInput">Activity Date</label>
          <input class="challenge-join-input" id="activityDateInput" name="ActivityDate" type="date" value="@Model.UploadActivityPrefill.ActivityDate.ToString("yyyy-MM-dd")" required />
        </div>
        <div class="challenge-join-field">
          <label class="challenge-join-label" for="distanceKmInput">Distance (KM)</label>
          <input class="challenge-join-input" id="distanceKmInput" name="DistanceKm" type="number" min="0.01" step="0.01" placeholder="5.00" required />
        </div>
        <div class="challenge-join-field">
          <label class="challenge-join-label">Moving Time</label>
          <div class="activity-time-grid">
            <input class="challenge-join-input" name="Hours" type="number" min="0" max="23" placeholder="hrs" required />
            <input class="challenge-join-input" name="Minutes" type="number" min="0" max="59" placeholder="min" required />
            <input class="challenge-join-input" name="Seconds" type="number" min="0" max="59" placeholder="sec" required />
          </div>
        </div>
        <div class="challenge-join-field challenge-join-field--full">
          <label class="challenge-join-label" for="activityNotesInput">Notes</label>
          <textarea class="challenge-join-textarea" id="activityNotesInput" name="Notes" maxlength="500" placeholder="Optional activity notes"></textarea>
        </div>
        <div class="challenge-join-field challenge-join-field--full">
          <label class="challenge-join-label" for="proofImageInput">Proof Image</label>
          <input class="challenge-join-input" id="proofImageInput" name="ProofImage" type="file" accept=".jpg,.jpeg,.png,.webp" />
        </div>
      </div>
      <div class="challenge-join-actions">
        <button type="button" class="challenge-join-btn-secondary" id="activityUploadCancel">Cancel</button>
        <button type="submit" class="challenge-join-btn-primary">Submit Activity</button>
      </div>
    </form>
  </div>
</div>

<div class="challenge-join-modal proof-preview-modal" id="proofPreviewModal" aria-hidden="true">
  <div class="challenge-join-panel" role="dialog" aria-modal="true" aria-labelledby="proofPreviewTitle">
    <div class="challenge-join-head">
      <div>
        <div class="challenge-join-title" id="proofPreviewTitle">Proof Image</div>
        <div class="challenge-join-sub" id="proofPreviewSubtitle">Challenge activity proof preview</div>
      </div>
      <button type="button" class="challenge-join-close" id="proofPreviewClose" aria-label="Close">&times;</button>
    </div>
    <div class="proof-preview-stage">
      <img id="proofPreviewImage" alt="Proof image preview" />
    </div>
    <div class="proof-preview-caption" id="proofPreviewCaption"></div>
  </div>
</div>

<div class="challenge-join-modal" id="challengeJoinModal" aria-hidden="true">
  <div class="challenge-join-panel" role="dialog" aria-modal="true" aria-labelledby="challengeJoinTitle">
    <div class="challenge-join-head">
      <div>
        <div class="challenge-join-title" id="challengeJoinTitle">Join Challenge</div>
        <div class="challenge-join-sub">Submit your registration. Admin approval is required before you can join the challenge.</div>
      </div>
      <button type="button" class="challenge-join-close" id="challengeJoinClose" aria-label="Close">&times;</button>
    </div>
    <form id="challengeJoinForm" method="post" asp-controller="Home" asp-action="JoinChallengeSubmit">
      @Html.AntiForgeryToken()
      <input type="hidden" name="ChallengeId" id="challengeJoinChallengeId" />
      <div class="challenge-join-grid">
        <div class="challenge-join-field challenge-join-field--full">
          <label class="challenge-join-label" for="challengeJoinChallengeName">Challenge</label>
          <input class="challenge-join-input" id="challengeJoinChallengeName" type="text" readonly />
        </div>
        <div class="challenge-join-field">
          <label class="challenge-join-label" for="challengeJoinFullName">Full Name</label>
          <input class="challenge-join-input" id="challengeJoinFullName" name="FullName" value="@joinPrefill.FullName" maxlength="200" required />
          <div class="challenge-join-error" data-valmsg-for="FullName"></div>
        </div>
        <div class="challenge-join-field">
          <label class="challenge-join-label" for="challengeJoinEmail">Email</label>
          <input class="challenge-join-input" id="challengeJoinEmail" name="Email" type="email" value="@joinPrefill.Email" maxlength="200" required />
          <div class="challenge-join-error" data-valmsg-for="Email"></div>
        </div>
        <div class="challenge-join-field">
          <label class="challenge-join-label" for="challengeJoinPhoneNumber">Phone Number</label>
          <input class="challenge-join-input" id="challengeJoinPhoneNumber" name="PhoneNumber" maxlength="50" />
          <div class="challenge-join-error" data-valmsg-for="PhoneNumber"></div>
        </div>
        <div class="challenge-join-field">
          <label class="challenge-join-label" for="challengeJoinCity">City</label>
          <input class="challenge-join-input" id="challengeJoinCity" name="City" maxlength="120" />
          <div class="challenge-join-error" data-valmsg-for="City"></div>
        </div>
        <div class="challenge-join-field challenge-join-field--full">
          <label class="challenge-join-label" for="challengeJoinNotes">Notes</label>
          <textarea class="challenge-join-textarea" id="challengeJoinNotes" name="Notes" maxlength="500" placeholder="Optional notes for the admin review"></textarea>
          <div class="challenge-join-error" data-valmsg-for="Notes"></div>
        </div>
      </div>
      <div class="challenge-join-actions">
        <button type="button" class="challenge-join-btn-secondary" id="challengeJoinCancel">Cancel</button>
        <button type="submit" class="challenge-join-btn-primary" id="challengeJoinSubmit">Submit Registration</button>
      </div>
      <div class="challenge-join-status" id="challengeJoinStatus"></div>
    </form>
  </div>
</div>

<script>
function switchTab(name, btn) {
  document.querySelectorAll('.tab-panel').forEach(function (panel) { panel.classList.remove('active'); });
  document.getElementById('tab-' + name).classList.add('active');
  document.querySelectorAll('.pg-tab').forEach(function (tab) { tab.classList.remove('active'); });
  btn.classList.add('active');

  var titles = { challenges: 'Challenges', vouchers: 'MY REWARDS', activities: 'Challenge Participation' };
  var subtitles = {
    challenges: '@Model.ActiveCount Active',
    vouchers: '@activeVouchers.Count Active',
    activities: '@Model.MyActivitiesCount Joined'
  };

  document.getElementById('pg-title').textContent = titles[name];
  document.getElementById('pg-sub').textContent = subtitles[name];
}

(function () {
  var modal = document.getElementById('challengeJoinModal');
  var form = document.getElementById('challengeJoinForm');
  if (!modal || !form) return;

  var challengeIdInput = document.getElementById('challengeJoinChallengeId');
  var challengeNameInput = document.getElementById('challengeJoinChallengeName');
  var statusBox = document.getElementById('challengeJoinStatus');
  var submitBtn = document.getElementById('challengeJoinSubmit');
  function clearJoinErrors() {
    form.querySelectorAll('[data-valmsg-for]').forEach(function (el) { el.textContent = ''; });
    statusBox.textContent = '';
    statusBox.classList.remove('is-visible');
  }

  function openJoinModal(challengeId, challengeTitle) {
    clearJoinErrors();
    challengeIdInput.value = challengeId || '';
    challengeNameInput.value = challengeTitle || '';
    modal.classList.add('is-open');
    modal.setAttribute('aria-hidden', 'false');
  }

  function closeJoinModal() {
    modal.classList.remove('is-open');
    modal.setAttribute('aria-hidden', 'true');
  }

  document.querySelectorAll('[data-join-challenge]').forEach(function (button) {
    button.addEventListener('click', function () {
      openJoinModal(button.getAttribute('data-challenge-id'), button.getAttribute('data-challenge-title'));
    });
  });

  document.getElementById('challengeJoinClose')?.addEventListener('click', closeJoinModal);
  document.getElementById('challengeJoinCancel')?.addEventListener('click', closeJoinModal);
  modal.addEventListener('click', function (event) {
    if (event.target === modal) closeJoinModal();
  });

  form.addEventListener('submit', function () {
    clearJoinErrors();
    submitBtn.disabled = true;
    submitBtn.textContent = 'Submitting...';
  });
})();

(function () {
  var activityModal = document.getElementById('activityUploadModal');
  var challengeNameInput = document.getElementById('activityChallengeName');
  var participantIdInput = document.getElementById('activityParticipantId');
  var challengeIdInput = document.getElementById('activityChallengeId');
  var activityTypeInput = document.getElementById('activityTypeInput');
  if (!activityModal) return;

  function openActivityModal(button) {
    participantIdInput.value = button.getAttribute('data-participant-id') || '';
    challengeIdInput.value = button.getAttribute('data-challenge-id') || '';
    challengeNameInput.value = button.getAttribute('data-challenge-title') || '';
    activityTypeInput.value = button.getAttribute('data-activity-type') || 'Run';
    activityModal.classList.add('is-open');
    activityModal.setAttribute('aria-hidden', 'false');
  }

  function closeActivityModal() {
    activityModal.classList.remove('is-open');
    activityModal.setAttribute('aria-hidden', 'true');
  }

  document.querySelectorAll('[data-open-activity-upload]').forEach(function (button) {
    button.addEventListener('click', function () {
      openActivityModal(button);
    });
  });

  document.getElementById('activityUploadClose')?.addEventListener('click', closeActivityModal);
  document.getElementById('activityUploadCancel')?.addEventListener('click', closeActivityModal);
  activityModal.addEventListener('click', function (event) {
    if (event.target === activityModal) closeActivityModal();
  });
})();

(function () {
  var proofModal = document.getElementById('proofPreviewModal');
  var proofImage = document.getElementById('proofPreviewImage');
  var proofCaption = document.getElementById('proofPreviewCaption');
  var proofSubtitle = document.getElementById('proofPreviewSubtitle');
  var closeButton = document.getElementById('proofPreviewClose');
  if (!proofModal || !proofImage || !proofCaption || !proofSubtitle || !closeButton) return;

  function openProofPreview(url, title) {
    proofImage.src = url || '';
    proofImage.alt = title || 'Proof image preview';
    proofCaption.textContent = title || '';
    proofSubtitle.textContent = title || 'Challenge activity proof preview';
    proofModal.classList.add('is-open');
    proofModal.setAttribute('aria-hidden', 'false');
  }

  function closeProofPreview() {
    proofModal.classList.remove('is-open');
    proofModal.setAttribute('aria-hidden', 'true');
    proofImage.src = '';
    proofCaption.textContent = '';
    proofSubtitle.textContent = 'Challenge activity proof preview';
  }

  document.querySelectorAll('[data-open-proof-preview]').forEach(function (button) {
    button.addEventListener('click', function () {
      openProofPreview(button.getAttribute('data-proof-url'), button.getAttribute('data-proof-title'));
    });
  });

  closeButton.addEventListener('click', closeProofPreview);
  proofModal.addEventListener('click', function (event) {
    if (event.target === proofModal) closeProofPreview();
  });
  document.addEventListener('keydown', function (event) {
    if (event.key === 'Escape' && proofModal.classList.contains('is-open')) {
      closeProofPreview();
    }
  });
})();

(function () {
  var currentTab = new URLSearchParams(window.location.search).get('tab');
  if (!currentTab) return;

  var targetButton = Array.from(document.querySelectorAll('.pg-tab')).find(function (button) {
    return (button.textContent || '').trim().toLowerCase() === currentTab.toLowerCase().replace('-', ' ');
  });

  if (currentTab === 'activities') {
    targetButton = document.querySelector('.pg-tab[onclick*=\"activities\"]');
  } else if (currentTab === 'vouchers') {
    targetButton = document.querySelector('.pg-tab[onclick*=\"vouchers\"]');
  } else if (currentTab === 'challenges') {
    targetButton = document.querySelector('.pg-tab[onclick*=\"challenges\"]');
  }

  if (targetButton) {
    targetButton.click();
  }
})();

(function () {
  var joinedButton = document.getElementById('joinedChallengesFilterBtn');
  var approvedButton = document.getElementById('approvedChallengesFilterBtn');
  var pendingButton = document.getElementById('pendingChallengesFilterBtn');
  var filterButton = document.getElementById('withUploadsFilterBtn');
  var resetButton = document.getElementById('resetActivityFilterBtn');
  var filterRow = document.getElementById('activityFilterRow');
  var filterLabel = document.getElementById('activityFilterLabel');
  var participationGrid = document.getElementById('challengeParticipationGrid');
  var uploadsGrid = document.getElementById('uploadedActivitiesGrid');
  if (!joinedButton || !approvedButton || !pendingButton || !filterButton || !resetButton || !filterRow || !filterLabel || !uploadsGrid) return;

  var statButtons = [joinedButton, approvedButton, pendingButton, filterButton];
  var cards = participationGrid ? Array.from(participationGrid.querySelectorAll('.activity-card')) : [];

  function setActiveButton(activeButton) {
    statButtons.forEach(function (button) {
      button.classList.toggle('is-active', button === activeButton);
    });
  }

  function applyView(mode) {
    setActiveButton(
      mode === 'approved' ? approvedButton :
      mode === 'pending' ? pendingButton :
      mode === 'uploads' ? filterButton :
      joinedButton
    );

    if (participationGrid) {
      participationGrid.style.display = mode === 'uploads' ? 'none' : '';
    }

    uploadsGrid.style.display = mode === 'uploads' ? 'block' : 'none';

    if (mode === 'joined') {
      cards.forEach(function (card) { card.style.display = ''; });
      filterRow.style.display = 'none';
      return;
    }

    filterRow.style.display = 'flex';

    if (mode === 'approved') {
      filterLabel.textContent = 'Showing approved challenge participation';
      cards.forEach(function (card) {
        card.style.display = card.getAttribute('data-status') === 'approved' ? '' : 'none';
      });
      return;
    }

    if (mode === 'pending') {
      filterLabel.textContent = 'Showing pending challenge participation';
      cards.forEach(function (card) {
        card.style.display = card.getAttribute('data-status') === 'pending' ? '' : 'none';
      });
      return;
    }

    filterLabel.textContent = 'Showing all uploaded activities';
  }

  joinedButton.addEventListener('click', function () { applyView('joined'); });
  approvedButton.addEventListener('click', function () { applyView('approved'); });
  pendingButton.addEventListener('click', function () { applyView('pending'); });
  filterButton.addEventListener('click', function () { applyView('uploads'); });

  resetButton.addEventListener('click', function () {
    applyView('joined');
  });
})();
</script>
