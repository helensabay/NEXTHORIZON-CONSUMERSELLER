    .seller-signup-sidebar {
        background: var(--color-black);
        color: var(--color-white);
        padding: 2rem;
        display: flex;
        flex-direction: column;
        position: sticky;
        top: 70px;
        height: calc(100vh - 70px);
        overflow-y: auto;
    }

    .seller-signup-brand { margin-bottom: 2rem; }
    .seller-signup-brand .logo { color: var(--color-white); }
    .seller-signup-brand .logo-image {
    width: 52px;
    height: 52px;
    object-fit: contain;
}
    .seller-signup-info h2 { color: var(--color-white); font-size: 1.5rem; margin-bottom: 1rem; }
    .seller-signup-info p  { color: var(--color-light-gray); margin-bottom: 2rem; }

    .seller-signup-steps { display: flex; flex-direction: column; gap: 1.5rem; }

    .seller-signup-step {
        display: flex; align-items: center; gap: 1rem;
        opacity: 0.6; transition: var(--transition-normal);
    }
    .seller-signup-step.active { opacity: 1; }

    .seller-signup-step-number {
        width: 32px; height: 32px;
        background: var(--neon-red);
        border-radius: 50%;
        display: flex; align-items: center; justify-content: center;
        font-weight: 700; flex-shrink: 0;
    }

    .seller-signup-footer { margin-top: auto; padding-top: 2rem; }

    .seller-signup-main {
        padding: 3rem;
        background: var(--color-off-white);
        overflow-y: auto;
    }

    .seller-signup-header { margin-bottom: 2rem; }
    .seller-signup-header h1 { font-size: 2rem; margin-bottom: 0.5rem; }
    .seller-signup-header p  { color: var(--color-gray); }

    .form-section {
        background: var(--color-white);
        padding: 2rem;
        border-radius: var(--border-radius-lg);
        margin-bottom: 2rem;
        box-shadow: var(--shadow-sm);
    }

    .form-section-title { font-size: 1.25rem; margin-bottom: 1.5rem; }

    .business-type-selection {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1rem;
        margin-bottom: 1rem;
    }

    .business-type-card {
        border: 2px solid var(--color-lighter-gray);
        border-radius: var(--border-radius-md);
        padding: 1.5rem;
        cursor: pointer;
        transition: var(--transition-normal);
        text-align: center;
    }
    .business-type-card:hover { border-color: var(--color-black); }
    .business-type-card input { display: none; }
    .business-type-card input:checked + .business-type-icon { background: var(--neon-red); }

    .business-type-icon {
        width: 60px; height: 60px;
        background: var(--color-black);
        border-radius: 50%;
        display: flex; align-items: center; justify-content: center;
        margin: 0 auto 1rem;
        font-size: 1.5rem; color: var(--color-white);
        transition: var(--transition-normal);
    }

    .business-type-card h3 { font-size: 1rem; margin-bottom: 0.5rem; }
    .business-type-card p  { font-size: 0.8rem; color: var(--color-gray); }

    .document-upload-section {
        background: var(--color-white);
        padding: 2rem;
        border-radius: var(--border-radius-lg);
        margin-bottom: 2rem;
        box-shadow: var(--shadow-sm);
    }
    .document-upload-section h3 { margin-bottom: 1.5rem; }

    .document-upload-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 1rem;
    }

    .document-upload-item  { position: relative; }
    .document-upload-input { display: none; }

    .document-upload-label {
        display: flex; flex-direction: column;
        align-items: center; justify-content: center;
        padding: 2rem;
        border: 2px dashed var(--color-lighter-gray);
        border-radius: var(--border-radius-md);
        cursor: pointer;
        transition: var(--transition-normal);
    }
    .document-upload-label:hover { border-color: var(--color-black); background: var(--color-off-white); }

    .document-upload-icon { font-size: 2rem; color: var(--color-gray); margin-bottom: 0.5rem; }
    .document-upload-text { font-weight: 600; margin-bottom: 0.25rem; }
    .document-upload-hint { font-size: 0.8rem; color: var(--color-gray); }

    .form-row   { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
    .form-group { margin-bottom: 1.5rem; }

    .form-label {
        display: block; font-weight: 600;
        font-size: 0.875rem; margin-bottom: 0.5rem;
        color: var(--color-black);
    }

    .form-input {
        width: 100%; padding: 0.875rem 1rem;
        border: 2px solid var(--color-lighter-gray);
        border-radius: var(--border-radius-md);
        font-size: 1rem; transition: var(--transition-fast);
        box-sizing: border-box;
    }
    .form-input:focus         { outline: none; border-color: var(--color-black); }
    .form-input.input-invalid { border-color: #e74c3c !important; }
    .form-input.input-valid   { border-color: #28a745 !important; }

    .password-input-wrapper {
        position: relative; display: flex; align-items: center;
    }
    .password-input-wrapper .form-input { padding-right: 3rem; }

    .password-toggle {
        position: absolute; right: 10px;
        background: none; border: none;
        cursor: pointer; padding: 0;
        display: flex; align-items: center;
        color: var(--color-gray);
    }
    .password-toggle:hover { color: var(--color-black); }

    .password-rules { margin-top: 8px; display: flex; flex-direction: column; gap: 4px; }
    .rule { font-size: 0.75rem; display: flex; align-items: center; gap: 6px; }
    .rule.pass { color: #28a745; }
    .rule.fail { color: #e74c3c; }
    .rule i    { font-size: 0.75rem; }

    .terms-checkbox {
        display: flex; align-items: flex-start;
        gap: 0.5rem; margin-bottom: 1.5rem;
    }
    .terms-checkbox input  { margin-top: 0.25rem; }
    .terms-checkbox label  { font-size: 0.9rem; color: var(--color-medium-gray); }
    .terms-checkbox a      { color: var(--color-black); font-weight: 500; }

    .auth-submit { padding: 1rem; font-size: 1rem; }

    .btn {
        display: inline-flex; align-items: center; justify-content: center;
        gap: 0.5rem; padding: 0.875rem 1.75rem; font-size: 0.95rem;
        font-weight: 600; border-radius: var(--border-radius-md);
        cursor: pointer; transition: var(--transition-normal); border: none;
    }
    .btn-primary       { background: var(--color-black); color: white; }
    .btn-primary:hover { background: var(--color-dark-gray); transform: translateY(-2px); }

    /* ── SWEETALERT ── */
    .nh-alert       { background: #fff !important; color: #000 !important; border-radius: 12px; padding: 30px; width: 420px; }
    .nh-alert-title { color: #000 !important; font-size: 22px; font-weight: 600; }
    .nh-alert-text  { color: #000 !important; font-size: 15px; }
    .nh-alert-btn   { background: #000 !important; color: #fff !important; padding: 10px 28px; border-radius: 6px; }
    .nh-alert-btn:focus, .nh-alert-btn:active, .nh-alert-btn:focus-visible { box-shadow: none !important; outline: none !important; }
    .swal2-confirm        { box-shadow: none !important; outline: none !important; }
    .swal2-icon.swal2-error   { border-color: #000 !important; }
    .swal2-icon.swal2-success { border-color: #000 !important; }
    .swal2-icon.swal2-warning { border-color: #000 !important; }
    .swal2-success-ring       { border-color: #000 !important; }
    .swal2-success-line-tip, .swal2-success-line-long { background: #000 !important; }
    .swal2-x-mark-line-left,  .swal2-x-mark-line-right { background: #000 !important; }
    .swal2-warning-body, .swal2-warning-dot { background: #000 !important; }

    @@media (max-width: 1024px) {
        .seller-signup-container { grid-template-columns: 1fr; }
        .seller-signup-sidebar   { display: none; }
        .business-type-selection { grid-template-columns: 1fr; }
        .document-upload-grid    { grid-template-columns: 1fr; }
    }

    @@media (max-width: 768px) {
        .seller-signup-main { padding: 1.5rem; }
        .form-row           { grid-template-columns: 1fr; }
        .form-section       { padding: 1.5rem; }
    }
</style>

</body>
</html>
