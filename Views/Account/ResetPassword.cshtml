@model WebApplication1.ViewModels.ResetPasswordViewModel
@{
    ViewData["Title"] = "Reset Password - Next Horizon";
}

<div class="auth-page">
    <div class="auth-container">
        <div class="auth-form-container">
            <div class="auth-header">
                <h2>Reset Password</h2>
                <p>Enter your new password and confirm it</p>
            </div>

            <form id="resetForm" asp-action="ResetPassword" method="post" class="auth-form">
                <input type="hidden" asp-for="Email" />

                <div class="form-group">
                    <label asp-for="NewPassword" class="form-label">New Password</label>
                    <div class="password-wrapper">
                        <input asp-for="NewPassword" class="form-input" id="newPass"
                               placeholder="New password" type="password"
                               oninput="checkPassword(this.value)" />
                        <button type="button" class="toggle-password" onclick="togglePassword('newPass', this)">
                            <i class="fas fa-eye"></i>
                        </button>
                    </div>
                    <!-- Live Checker -->
                    <div class="password-rules" id="passwordRules">
                        <span id="rule-lower"  class="rule fail"><i class="fas fa-times-circle"></i> At least one lowercase character</span>
                        <span id="rule-upper"  class="rule fail"><i class="fas fa-times-circle"></i> At least one uppercase character</span>
                        <span id="rule-length" class="rule fail"><i class="fas fa-times-circle"></i> 8-16 characters</span>
                        <span id="rule-valid"  class="rule pass"><i class="fas fa-check-circle"></i> Only letters, numbers and common punctuation can be used</span>
                    </div>
                    <span asp-validation-for="NewPassword" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="ConfirmPassword" class="form-label">Confirm Password</label>
                    <div class="password-wrapper">
                        <input asp-for="ConfirmPassword" class="form-input" id="confirmPass"
       placeholder="Confirm new password" type="password"
       oninput="checkConfirmPassword(this.value)" />
                        <button type="button" class="toggle-password" onclick="togglePassword('confirmPass', this)">
                            <i class="fas fa-eye"></i>
                        </button>
                    </div>
                    <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                </div>

                <button type="submit" class="btn btn-primary auth-submit" id="submitBtn">
                    <i class="fas fa-lock"></i> Reset Password
                </button>
            </form>
        </div>
    </div>
</div>

@if (ViewData["ResetError"] != null)
{
    <input type="hidden" id="resetError" value="@ViewData["ResetError"]" />
}
@if (ViewData["ResetSuccess"] != null)
{
    <input type="hidden" id="resetSuccess" value="@ViewData["ResetSuccess"]" />
}

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<script>
    function nhAlert(icon, title, text, confirmText = 'OK') {
        return Swal.fire({
            icon,
            title,
            text,
            confirmButtonText: confirmText,
            customClass: {
                popup:         'nh-alert',
                title:         'nh-alert-title',
                htmlContainer: 'nh-alert-text',
                confirmButton: 'nh-alert-btn'
            }
        });
    }

    document.addEventListener('DOMContentLoaded', function () {
        const errorMsg   = document.getElementById('resetError')?.value;
        const successMsg = document.getElementById('resetSuccess')?.value;

        if (errorMsg) {
            nhAlert('error', 'Reset Failed', errorMsg);
        }

        if (successMsg) {
            nhAlert('success', 'Password Reset!', successMsg, 'Go to Login')
                .then(() => {
                    window.location.href = '@Url.Action("Login", "Account")';
                });
        }
    });

 let passwordValid = false;

document.getElementById("resetForm").addEventListener("submit", function (e) {
    const newPass     = document.getElementById("newPass").value.trim();
    const confirmPass = document.getElementById("confirmPass").value.trim();

    // ── 1. CHECK EMPTY FIELDS ──
    if (newPass === "" || confirmPass === "") {
        e.preventDefault();
        nhAlert('warning', 'Missing Fields', 'Please fill in both password fields.');
        return;
    }

    // ── 2. CHECK PASSWORD RULES ──
    if (!passwordValid) {
        e.preventDefault();
        document.getElementById('newPass').scrollIntoView({ behavior: 'smooth', block: 'center' });
        document.getElementById('newPass').focus();
        nhAlert('error', 'Weak Password', 'Your password does not meet all the requirements.');
        return;
    }

    // ── 3. CHECK PASSWORDS MATCH ──
    if (newPass !== confirmPass) {
        e.preventDefault();
        const confirmInput = document.getElementById('confirmPass');
        confirmInput.scrollIntoView({ behavior: 'smooth', block: 'center' });
        confirmInput.focus();
        confirmInput.classList.add('input-invalid');
        confirmInput.classList.remove('input-valid');
        nhAlert('error', 'Passwords Do Not Match', 'Please make sure both passwords are the same.');
        return;
    }

    // ── ALL GOOD ──
    const btn = document.getElementById('submitBtn');
    btn.disabled = true;
    btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Resetting...';
});
    function togglePassword(inputId, button) {
        const input  = document.getElementById(inputId);
        const icon   = button.querySelector('i');
        const hidden = input.type === 'password';
        input.type   = hidden ? 'text' : 'password';
        icon.classList.toggle('fa-eye',       !hidden);
        icon.classList.toggle('fa-eye-slash',  hidden);
    }

 function checkPassword(val) {
    const input  = document.getElementById('newPass');
    const lower  = document.getElementById('rule-lower');
    const upper  = document.getElementById('rule-upper');
    const length = document.getElementById('rule-length');
    const valid  = document.getElementById('rule-valid');

    const hasLower  = /[a-z]/.test(val);
    const hasUpper  = /[A-Z]/.test(val);
    const hasLength = val.length >= 8 && val.length <= 16;
    const hasValid  = /^[a-zA-Z0-9 !@@#$%^&*()_+\-=\[\]{}|;':",.<>?\/`~]*$/.test(val);

    setRule(lower,  hasLower);
    setRule(upper,  hasUpper);
    setRule(length, hasLength);
    setRule(valid,  hasValid);

    passwordValid = hasLower && hasUpper && hasLength && hasValid;
    input.classList.toggle('input-valid',   passwordValid);
    input.classList.toggle('input-invalid', !passwordValid && val.length > 0);
}

function checkConfirmPassword(val) {
    const confirmInput = document.getElementById('confirmPass');
    const passwordVal  = document.getElementById('newPass').value;
    if (val.length === 0) {
        confirmInput.classList.remove('input-valid', 'input-invalid');
        return;
    }
    if (val === passwordVal) {
        confirmInput.classList.add('input-valid');
        confirmInput.classList.remove('input-invalid');
    } else {
        confirmInput.classList.add('input-invalid');
        confirmInput.classList.remove('input-valid');
    }
}

    function setRule(el, pass) {
        el.className = 'rule ' + (pass ? 'pass' : 'fail');
        const icon = el.querySelector('i');
        icon.className = pass ? 'fas fa-check-circle' : 'fas fa-times-circle';
    }
</script>

<style>
    .auth-page {
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        background: var(--color-off-white);
        padding: 1.5rem;
    }

    .auth-container {
        width: 100%;
        max-width: 450px;
        background: var(--color-white);
        border-radius: var(--border-radius-lg);
        box-shadow: var(--shadow-xl);
        overflow: hidden;
    }

    .auth-form-container {
        padding: 3rem;
        display: flex;
        flex-direction: column;
    }

    .auth-header {
        text-align: center;
        margin-bottom: 2rem;
    }

    .auth-header h2 { font-size: 1.75rem; margin-bottom: 0.5rem; font-weight: 700; }
    .auth-header p  { color: var(--color-gray); font-size: 0.95rem; }

    .auth-form .form-group { margin-bottom: 1.5rem; }

    .form-label {
        display: block;
        margin-bottom: 0.5rem;
        font-size: 0.875rem;
        font-weight: 600;
        color: var(--color-black);
    }

    .form-input {
        width: 100%;
        padding: 0.875rem 1.25rem;
        border: 2px solid var(--color-lighter-gray);
        border-radius: var(--border-radius-md);
        font-size: 1rem;
        box-sizing: border-box;
        transition: border-color 0.2s;
    }

    .form-input:focus         { outline: none; border-color: var(--color-black); }
    .form-input.input-invalid { border-color: #e74c3c !important; }
    .form-input.input-valid   { border-color: #28a745 !important; }

    .password-wrapper {
        position: relative;
        display: flex;
        align-items: center;
    }

    .password-wrapper .form-input { padding-right: 3rem; }

    .toggle-password {
        position: absolute;
        right: 0.875rem;
        top: 50%;
        transform: translateY(-50%);
        background: none;
        border: none;
        color: var(--color-gray);
        cursor: pointer;
        padding: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1rem;
        transition: color 0.2s;
    }

    .toggle-password:hover { color: var(--color-black); }

    .password-rules {
        margin-top: 8px;
        display: flex;
        flex-direction: column;
        gap: 4px;
    }

    .rule { font-size: 0.75rem; display: flex; align-items: center; gap: 6px; }
    .rule.pass { color: #28a745; }
    .rule.fail { color: #e74c3c; }
    .rule i    { font-size: 0.75rem; }

    .auth-submit {
        width: 100%;
        padding: 0.875rem;
        font-size: 1rem;
        background-color: var(--color-black);
        color: white;
        border: none;
        border-radius: var(--border-radius-md);
        cursor: pointer;
        font-weight: 600;
        transition: opacity 0.2s;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
    }

    .auth-submit:hover    { opacity: 0.85; }
    .auth-submit:disabled { opacity: 0.6; cursor: not-allowed; }

    .nh-alert          { background: #fff !important; color: #000 !important; border-radius: 12px; padding: 30px; width: 420px; }
    .nh-alert-title    { color: #000 !important; font-size: 22px; font-weight: 600; }
    .nh-alert-text     { color: #000 !important; font-size: 15px; }
    .nh-alert-btn      { background: #000 !important; color: #fff !important; padding: 10px 28px; border-radius: 6px; }
    .nh-alert-btn:focus,
    .nh-alert-btn:active,
    .nh-alert-btn:focus-visible { box-shadow: none !important; outline: none !important; }
    .swal2-icon.swal2-error   { border-color: #000 !important; }
    .swal2-icon.swal2-success { border-color: #000 !important; }
    .swal2-success-ring       { border-color: #000 !important; }
    .swal2-success-line-tip,
    .swal2-success-line-long  { background: #000 !important; }
    .swal2-x-mark-line-left,
    .swal2-x-mark-line-right  { background: #000 !important; }
</style>